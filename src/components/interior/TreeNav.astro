---
// TreeNav — the two-level menu in the interior sidebar.
//
// Extracted from FamilyLawNav, which had been the only caller until the
// location pages needed the same list scoped to one city. It is the same
// extraction InteriorShell was: markup that had been copied once is now owned
// in one place, and the wrappers keep the domain knowledge.
//
// It knows nothing about collections. Callers hand it rows that are already
// sorted, labelled and resolved to hrefs; everything about what a parent is,
// which branch to open and where the card points lives in the wrapper.
//
// THE CLASS NAMES STILL READ "fl" — family law — and that is deliberate rather
// than left over. src/scripts/pa-nav.ts binds on `.fl__row` and
// `[data-pa-toggle]`, and the hide rule keys on `html[data-pa-boot]`; keeping
// all three meant this extraction emitted byte-identical HTML on the 33 routes
// that already rendered the menu, so it could be proved a no-op by diffing them
// rather than by arguing about it. Renaming is a separate, provable change.
//
// Any page rendering this must do the two things the practice-area route does
// — stamp `data-pa-boot` on <html> from a blocking head script, and call
// initPracticeAreaNav() — or the branches render open and the "+" buttons do
// nothing. Without JS the attribute never lands, every branch stays open, and
// no link is unreachable.

import SidebarCard from "../blog/SidebarCard.astro";

export interface TreeNavRow {
  id: string;
  label: string;
  href: string;
  children: { id: string; label: string; href: string }[];
}

interface Props {
  title: string;
  cardId: string;

  /* The section index this card heads, when there is one. */
  cardHref?: string;

  rows: TreeNavRow[];

  /* Namespaces the `id`s that wire each "+" button to the list it controls.
     Separate from `cardId` because the two are not the same string on the
     practice-area menu ("fl-nav" heads a card whose rows are "fl-divorce"),
     and rows are what aria-controls points at. */
  rowIdPrefix: string;

  /* The row or child to mark as the page you are on. Omitted when the menu is
     rendered somewhere outside the section it describes — the About Us pages
     carry it as a cross-reference, and no row there is "the page you are on". */
  currentId?: string;

  /* The branch to render expanded. Nothing opens when it is omitted, which is
     the right resting state for a menu pointing away from the current page
     rather than locating you within it. */
  openId?: string;
}

const { title, cardId, cardHref, rows, rowIdPrefix, currentId, openId } = Astro.props;

const rowId = (id: string) => `${rowIdPrefix}-${id.replace(/\//g, "-")}`;
---

<SidebarCard title={title} id={cardId} href={cardHref}>
  <ul class="fl">
    {
      rows.map((row) => {
        const hasKids = row.children.length > 0;
        const isOpen = hasKids && row.id === openId;
        const isCurrent = row.id === currentId;

        return (
          <li class:list={["fl__row", { "is-expanded": isOpen }]}>
            <div class="fl__head">
              <a
                class:list={["fl__link", { "is-active": isCurrent }]}
                href={row.href}
                aria-current={isCurrent ? "page" : undefined}
              >
                <span>{row.label}</span>

                {!hasKids && (
                  <span class="fl__mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path
                        d="M5 12h13m-5-6 6 6-6 6"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                )}
              </a>

              {hasKids && (
                <button
                  class="fl__toggle"
                  type="button"
                  data-pa-toggle
                  aria-expanded={isOpen ? "true" : "false"}
                  aria-controls={rowId(row.id)}
                >
                  <span class="visually-hidden">{`Show pages under ${row.label}`}</span>
                  <span class="fl__mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path
                        d="M12 5v14M5 12h14"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                      />
                    </svg>
                  </span>
                </button>
              )}
            </div>

            {hasKids && (
              <ul class="fl__kids" id={rowId(row.id)}>
                {row.children.map((child) => (
                  <li>
                    <a
                      class:list={["fl__kid", { "is-active": child.id === currentId }]}
                      href={child.href}
                      aria-current={child.id === currentId ? "page" : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })
    }
  </ul>
</SidebarCard>

<style>
  .fl {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl__row + .fl__row {
    border-top: 1px solid var(--bone-300);
  }

  .fl__head {
    display: flex;
    align-items: stretch;
  }

  .fl__link {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-width: 0;
    padding: 15px 0;
    font-family: var(--font-ui);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--navy-700);
    text-decoration: none;
    transition: color var(--dur-base) var(--ease-out);
  }

  .fl__link:hover {
    color: var(--gold-600);
  }

  /* The page you are on. Weight and colour, plus aria-current on the element
     itself so it doesn't rest on colour alone. */
  .fl__link.is-active {
    color: var(--gold-600);
    font-weight: 700;
  }

  /* Both glyphs share a box, so a "+" row and an arrow row line up exactly. */
  .fl__mark {
    display: flex;
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--gold-500);
    transition: color var(--dur-base) var(--ease-out);
  }

  .fl__mark svg {
    width: 100%;
    height: 100%;
  }

  .fl__link:hover .fl__mark {
    color: var(--gold-600);
  }

  /* ---- The expand control ---- */

  /* A button, not a second link: it changes the state of this list rather than
     going anywhere. Padded left so its hit area doesn't crowd the label. */
  .fl__toggle {
    display: flex;
    align-items: center;
    flex: none;
    padding: 0 0 0 14px;
    margin: 0;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--gold-500);
    transition: color var(--dur-base) var(--ease-out);
  }

  .fl__toggle:hover {
    color: var(--gold-600);
  }

  .fl__toggle .fl__mark {
    transition:
      transform var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  /* The plus turns a quarter turn into a cross when open — the same gesture
     the homepage FAQ accordion uses. */
  .fl__row.is-expanded .fl__toggle .fl__mark {
    transform: rotate(45deg);
  }

  /* ---- Children ---- */

  /* Hung off a hairline and indented, so the group reads as belonging to the
     row above rather than as more siblings. */
  .fl__kids {
    margin: 0 0 14px;
    padding: 2px 0 0 16px;
    list-style: none;
    border-left: 1px solid var(--bone-300);
  }

  /* Closed by default only when the script is there to open them again.
     `data-pa-boot` is stamped on <html> by a blocking head script, so a closed
     branch is never painted open first — the same trick FilterBoot uses on the
     Blog index, and for the same reason: collapsing rows after first paint
     reads as a bug. Without JS the attribute is absent, every branch stays
     open, and no page in the section is unreachable. */
  :global(html[data-pa-boot]) .fl__row:not(.is-expanded) .fl__kids {
    display: none;
  }

  .fl__kid {
    display: block;
    padding: 9px 0;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-500);
    text-decoration: none;
    transition: color var(--dur-base) var(--ease-out);
  }

  .fl__kid:hover {
    color: var(--gold-600);
  }

  .fl__kid.is-active {
    color: var(--gold-600);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .fl__toggle .fl__mark {
      transition: color var(--dur-base) var(--ease-out);
    }
  }
</style>
