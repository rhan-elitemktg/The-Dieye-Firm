---
// Testimonials hero — full-bleed consultation photo with a navy side-scrim
// holding the copy on the left.
//
// Same structure as practice-areas/PracticeAreasHero.astro and
// about/PapaHero.astro, which solve the identical problem: a bright photo, copy
// on the left, and the header in flow above rather than overlaying it.
//
// The source is 1200x896, the smallest hero on the site, so `widths` stops at
// its native width — asking Astro for a 1920 variant would upscale rather than
// sharpen. The band stretches the 1200 file, which is the same trade the other
// two heroes make.

import { Image } from "astro:assets";
import Eyebrow from "../Eyebrow.astro";
import consultation from "../../assets/images/hero-testimonials.jpg";
---

<section class="tshero">
  <div class="tshero__media">
    <Image
      class="tshero__img"
      src={consultation}
      alt="Attorney Papa Dieye going through paperwork at a table with a client"
      widths={[768, 1024, 1200]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="tshero__scrim" aria-hidden="true"></div>
  </div>

  <div class="container tshero__inner">
    <div class="tshero__content">
      <Eyebrow light eager>Client Reviews</Eyebrow>

      <h1 class="tshero__title">What our clients <em>say.</em></h1>

      {/* The comp's em dash becomes a spaced hyphen, per AGENTS.md. */}
      <p class="tshero__lead">
        For more than seventeen years, families across Pearland and Houston have
        trusted The Dieye Firm through their hardest days. Here is what they have
        to say - in their own words.
      </p>

      <a class="btn btn--gold tshero__cta" href="/contact-us/">
        Schedule a Consultation
      </a>
    </div>
  </div>
</section>

<style>
  .tshero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: 640px;
    overflow: hidden;
    background: var(--navy-900);
  }

  .tshero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .tshero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Papa sits just right of centre and the client is a soft foreground mass
       on the left, so the crop is anchored right of centre: as the viewport
       narrows the empty bookshelves go before he does. Anchored high
       vertically because the bottom third is table and paperwork. */
    object-position: 58% 30%;
    filter: var(--photo-filter);
  }

  /* Lighter at the left end than PracticeAreasHero's: this frame opens on the
     client's out-of-focus shoulder rather than blown-out sky, so the copy has
     a dark base already and the gradient only has to finish the job. */
  .tshero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--navy-900) 0%,
      color-mix(in srgb, var(--navy-900) 86%, transparent) 44%,
      color-mix(in srgb, var(--navy-900) 40%, transparent) 72%,
      color-mix(in srgb, var(--navy-900) 18%, transparent) 100%
    );
  }

  /* The header sits in flow above this section, so the hero carries no offset
     for it. */
  .tshero__inner {
    padding-block: 96px 90px;
  }

  .tshero__content {
    max-width: 760px;
  }

  .tshero__title {
    margin: 22px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(40px, 3.2911vw + 1.163rem, 66px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
    max-width: 20ch;
  }

  .tshero__title em {
    font-style: italic;
    color: var(--gold-500);
  }

  .tshero__lead {
    max-width: 620px;
    margin-top: 28px;
    font-size: 18px;
    line-height: 30px;
    color: rgba(255, 255, 255, 0.9);
    text-wrap: pretty;
  }

  .tshero__cta {
    margin-top: 40px;
    padding: 14px 30px;
  }

  /* Tablet — less room for the photo, so the scrim tightens up to keep the
     headline legible where it now overlaps him. */
  @media (max-width: 1000px) {
    .tshero {
      min-height: 540px;
    }

    .tshero__scrim {
      background: linear-gradient(
        90deg,
        var(--navy-900) 0%,
        color-mix(in srgb, var(--navy-900) 90%, transparent) 50%,
        color-mix(in srgb, var(--navy-900) 60%, transparent) 82%,
        color-mix(in srgb, var(--navy-900) 30%, transparent) 100%
      );
    }

    .tshero__inner {
      padding-bottom: 72px;
    }

    .tshero__content {
      max-width: 620px;
    }
  }

  /* Mobile — a side-scrim can't work at this width: the copy would sit on top
     of Papa whatever the gradient does. The photo drops into flow as its own
     band with the copy on solid navy beneath, the same as the other two
     interior heroes. */
  @media (max-width: 650px) {
    .tshero {
      min-height: 0;
    }

    .tshero__media {
      position: relative;
      inset: auto;
      z-index: auto;
      height: clamp(300px, 46svh, 400px);
    }

    /* Nothing overlays the band now, so the crop can sit on the two of them
       properly rather than being pushed off the client. */
    .tshero__img {
      object-position: 52% 34%;
    }

    .tshero__scrim {
      background: linear-gradient(
        180deg,
        rgba(15, 36, 56, 0) 0%,
        rgba(15, 36, 56, 0.18) 52%,
        rgba(15, 36, 56, 0.72) 84%,
        var(--navy-900) 100%
      );
    }

    .tshero__inner {
      padding-block: 28px 56px;
    }

    .tshero__lead {
      font-size: 17px;
      line-height: 29px;
      margin-top: 22px;
    }

    .tshero__cta {
      margin-top: 32px;
      width: 100%;
    }
  }
</style>
