---
// Who We Are — the page's opening statement. Two-column split: the section
// title holds the left column, the copy and CTA the right.

import Eyebrow from "../Eyebrow.astro";
---

<section class="who section" aria-labelledby="who-title">
  <div class="container who__grid">
    <header class="who__head">
      <Eyebrow>Who We Are</Eyebrow>
      <h2 class="who__title" id="who-title">
        Not just a family lawyer, <em>a steady hand for your family.</em>
      </h2>
    </header>

    <div class="who__body">
      <p>
        When your family is going through a divorce, a custody dispute, or a
        sudden change in circumstances, it can feel like the ground has shifted
        beneath you. At The Dieye Firm, we understand that behind every case
        file is a parent worried about their children and a family simply
        trying to find a way forward.
      </p>
      <p>
        Our approach is people-first: we listen before we advise, we explain
        the law in plain language, and we never lose sight of the human beings
        at the center of every matter. You are not a number here. You are a
        neighbor, and your family's well-being is the measure of our work.
      </p>

      <a class="btn btn--gold who__cta" href="/practice-areas/">Our Practice Areas</a>
    </div>
  </div>
</section>

<style>
  .who {
    background: var(--white);
  }

  /* Two-column: the project's 1fr + 1fr with the 80px gap. */
  .who__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--section-gap);
    align-items: start;
  }

  .who__head {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .who__title {
    margin: 0;
    font-size: clamp(34px, 2.2785vw + 1.1994rem, 52px);
    line-height: 1.12;
  }

  .who__title em {
    font-style: italic;
    /* The deep gold, not the core brand gold: this sits on white, where
       --gold-500 drops under the 3:1 large-text floor. */
    color: var(--gold-600);
  }

  .who__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .who__body p {
    margin-bottom: 22px;
    font-size: 18px;
    line-height: 30px;
    color: var(--ink-500);
    text-wrap: pretty;
  }

  .who__cta {
    margin-top: 10px;
    padding: 14px 30px;
  }

  @media (max-width: 1439px) {
    .who__grid {
      column-gap: 56px;
    }
  }

  @media (max-width: 1000px) {
    .who__grid {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }
  }

  @media (max-width: 650px) {
    .who__body p {
      font-size: 17px;
      line-height: 29px;
    }

    .who__cta {
      width: 100%;
    }
  }
</style>
