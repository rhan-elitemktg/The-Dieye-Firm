---
// Who We Are — the page's opening statement. Two-column split: the section
// title holds the left column, the copy and CTA the right.

import Eyebrow from "../Eyebrow.astro";
import { getAboutPage, tail } from "../../sanity/aboutPage";

const copy = (await getAboutPage()).whoWeAre;
---

<section class="who section" aria-labelledby="who-title">
  <div class="container who__grid">
    <header class="who__head">
      <Eyebrow>{copy.eyebrow}</Eyebrow>
      <h2 class="who__title" id="who-title">
        {copy.headingLead}{" "}{copy.headingAccent && <em>{copy.headingAccent}</em>}{tail(copy.headingTail)}
      </h2>
    </header>

    <div class="who__body">
      {copy.paragraphs.map((text) => <p>{text}</p>)}

      <a class="btn btn--gold who__cta" href="/practice-areas/">{copy.ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  .who {
    background: var(--white);
  }

  /* Two-column: the project's 1fr + 1fr with the 80px gap. */
  .who__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--section-gap);
    align-items: start;
  }

  .who__head {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .who__title {
    margin: 0;
    font-size: clamp(34px, 2.2785vw + 1.1994rem, 52px);
    line-height: 1.12;
  }

  .who__title em {
    font-style: italic;
    /* The deep gold, not the core brand gold: this sits on white, where
       --gold-500 drops under the 3:1 large-text floor. */
    color: var(--gold-600);
  }

  .who__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .who__body p {
    margin-bottom: 22px;
    font-size: 18px;
    line-height: 30px;
    color: var(--ink-500);
    text-wrap: pretty;
  }

  .who__cta {
    margin-top: 10px;
    padding: 14px 30px;
  }

  @media (max-width: 1439px) {
    .who__grid {
      column-gap: 56px;
    }
  }

  @media (max-width: 1000px) {
    .who__grid {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }
  }

  @media (max-width: 650px) {
    .who__body p {
      font-size: 17px;
      line-height: 29px;
    }

    .who__cta {
      width: 100%;
    }
  }
</style>
