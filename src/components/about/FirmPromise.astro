---
// Promise — a full-bleed pull quote from Papa over the Pearland skyline shot,
// dimmed hard so the type carries the band on its own.

import { Image } from "astro:assets";
import waterTower from "../../assets/images/papa-water-tower.jpg";
import { getAttorney } from "../../sanity/siteWide";
import { getAboutPage, tail } from "../../sanity/aboutPage";

/* Title only — the name stays literal here, as it is part of the attribution
   line rather than a field the firm would retitle. */
const attorney = await getAttorney();
const copy = (await getAboutPage()).promise;
---

<section class="promise">
  <div class="promise__media">
    <Image
      class="promise__img"
      src={waterTower}
      alt=""
      widths={[768, 1024, 1300]}
      sizes="100vw"
      format="webp"
      quality={72}
      loading="lazy"
      decoding="async"
    />
    <div class="promise__scrim" aria-hidden="true"></div>
  </div>

  <figure class="promise__inner">
    <span class="promise__mark" aria-hidden="true">&ldquo;</span>
    <blockquote class="promise__quote">
      {copy.quoteLead}{" "}{copy.quoteAccent && <em>{copy.quoteAccent}</em>}{tail(copy.quoteTail)}
    </blockquote>
    <figcaption class="promise__attr">Papa Dieye &middot; {attorney.role}</figcaption>
  </figure>
</section>

<style>
  .promise {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: 480px;
    overflow: hidden;
    background: var(--navy-900);
  }

  .promise__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .promise__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  /* Heavier in the middle than at the edges, so the photo still reads as a
     photo at the top and bottom of the band while the quote sits on navy. */
  .promise__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--navy-900) 88%, transparent) 0%,
      color-mix(in srgb, var(--navy-900) 80%, transparent) 50%,
      color-mix(in srgb, var(--navy-900) 90%, transparent) 100%
    );
  }

  .promise__inner {
    max-width: 1040px;
    margin: 0;
    padding: 90px 40px;
    text-align: center;
  }

  .promise__mark {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-serif);
    font-size: 90px;
    line-height: 0.6;
    color: var(--gold-500);
  }

  .promise__quote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(30px, 2.5316vw + 1.1215rem, 50px);
    font-weight: var(--fw-medium);
    font-style: italic;
    line-height: 1.24;
    letter-spacing: -0.01em;
    color: #fff;
    text-wrap: balance;
  }

  .promise__quote em {
    font-style: italic;
    color: var(--gold-500);
  }

  .promise__attr {
    display: inline-block;
    margin-top: 28px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: var(--fw-bold);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
  }

  @media (max-width: 650px) {
    .promise {
      min-height: 0;
    }

    .promise__inner {
      padding: 56px 4px;
    }

    .promise__mark {
      font-size: 64px;
    }

    .promise__attr {
      letter-spacing: 0.18em;
    }
  }
</style>
