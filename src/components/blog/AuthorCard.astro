---
// AuthorCard — the attribution card that opens the post sidebar.
//
// Posts are bylined to the firm, not to an individual (13 of the 16 already
// were on the live site, and one had no byline at all), so this card credits
// Papa as the attorney behind the content rather than claiming he typed it.
//
// The name links straight to his profile. Only the name is a link: making the
// headshot one too would add a second tab stop to the same destination, which
// is the same reason home/Blog.astro marks its card images aria-hidden.

import { Image } from "astro:assets";
import papa from "../../assets/images/papa-headshot-square.jpg";
import { formatDate, isoDate } from "./blog";
import { getAttorney } from "../../sanity/siteWide";
import { croppedImage } from "../../sanity/image";

interface Props {
  /* Both optional, and both absent on practice-area pages. A practice area has
     no publish date and is not an article, so the footer line is omitted there
     rather than filled with something invented — the card still does its real
     job, which is to say who stands behind the page. */
  date?: Date;
  minutes?: number;
}

const { date, minutes } = Astro.props;

const attorney = await getAttorney();
const showFooter = date !== undefined && minutes !== undefined;
---

<section class="ac" aria-labelledby="ac-kicker">
  <p class="ac__kicker" id="ac-kicker"><span class="ac__rule" aria-hidden="true"></span>Reviewed by</p>

  <div class="ac__row">
    {/* The <img> stays here rather than in a shared component: `.ac__photo`
        is a scoped rule and a child component's markup never gets this
        component's hash. */}
    {attorney.photo?.asset ? (
      <img
        class="ac__photo"
        {...croppedImage(attorney.photo, 160, 160)}
        alt={`${attorney.name}, ${attorney.role.toLowerCase()} of The Dieye Firm`}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Image
        class="ac__photo"
        src={papa}
        alt={`${attorney.name}, ${attorney.role.toLowerCase()} of The Dieye Firm`}
        width={160}
        height={160}
        format="webp"
      loading="lazy"
      decoding="async"
      />
    )}
    <span class="ac__id">
      <a class="ac__name" href="/about-us/">{attorney.name}</a>
      <span class="ac__role">{attorney.role}</span>
    </span>
  </div>

  {/* "Posted on", not "Updated on" — the ingested archive only carries a
      publish date, and claiming a revision date we don't have would be wrong.
      This flips to "Updated on" once editors can actually revise a post, which
      is the Sanity pass: the source JSON-LD has a `dateModified` the scraper
      doesn't capture today. See HANDOFF.md. */}
  {
    showFooter && (
      <p class="ac__foot">
        Posted on
        <span class="ac__dot" aria-hidden="true" />
        <time datetime={isoDate(date!)}>{formatDate(date!)}</time>
        <span class="ac__dot" aria-hidden="true" />
        {minutes} min read
      </p>
    )
  }
</section>

<style>
  .ac {
    padding: 22px 24px 18px;
    background: var(--bone-50);
    border: 1px solid var(--bone-300);
    border-top: 3px solid var(--gold-500);
    border-radius: var(--radius-lg);
  }

  /* ---- Kicker ---- */
  .ac__kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-600);
  }

  .ac__rule {
    width: 22px;
    height: 2px;
    flex: none;
    background: var(--gold-500);
  }

  /* ---- Identity ---- */
  .ac__row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* The headshot's own backdrop is pale and merges into the cream card, so it
     needs a hairline to read as a circle at all. */
  .ac__photo {
    width: 60px;
    height: 60px;
    flex: none;
    border-radius: 50%;
    border: 1px solid var(--bone-300);
    object-fit: cover;
    object-position: center 12%;
  }

  .ac__name {
    display: inline-block;
    padding-bottom: 4px;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.1;
    color: var(--navy-900);
    text-decoration: none;
    border-bottom: 2px solid var(--bone-400);
    transition:
      color var(--dur-base) var(--ease-out),
      border-bottom-color var(--dur-base) var(--ease-out);
  }

  .ac__name:hover {
    color: var(--gold-600);
    border-bottom-color: var(--gold-500);
  }

  .ac__role {
    display: block;
    font-family: var(--font-ui);
    font-size: 13.5px;
    color: var(--ink-500);
  }

  /* ---- Footer ---- */
  .ac__foot {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 18px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--bone-300);
    font-family: var(--font-ui);
    font-size: 13.5px;
    color: var(--ink-500);
  }

  .ac__dot {
    width: 4px;
    height: 4px;
    flex: none;
    border-radius: 50%;
    background: var(--bone-400);
  }

  @media (max-width: 650px) {
    .ac {
      padding: 20px 20px 16px;
    }

    .ac__photo {
      width: 54px;
      height: 54px;
    }
  }
</style>
