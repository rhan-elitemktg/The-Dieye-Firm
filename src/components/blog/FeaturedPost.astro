---
// FeaturedPost — the navy split panel above the category filter. Photo left,
// copy right.
//
// It sits ABOVE the filter and is never filtered: whichever category is
// selected, this post stays put. That is why the chips render below it — the
// order tells you the panel is outside their scope rather than an item that
// stubbornly ignores them.

import { Image } from "astro:assets";
import fallbackImg from "../../assets/images/blog/blog-img.jpg";
import { categoryLabel, formatDate, isoDate, postHref, type Post } from "./blog";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const category = post.data.categories[0];
---

<section class="fp" aria-labelledby="fp-title">
  <div class="container">
    <div class="fp__panel">
      {/* Out of flow so the photo can't drive the row's height — the copy
          column sizes the panel and the photo fills whatever that comes to. */}
      <div class="fp__media">
        <Image
          src={post.data.image ?? fallbackImg}
          alt={post.data.imageAlt || ""}
          widths={[600, 900, 1200]}
          sizes="(max-width: 1000px) 100vw, 50vw"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <span class="fp__badge">Featured Post</span>
      </div>

      <div class="fp__body">
        <p class="fp__meta">
          {
            category && (
              <>
                <span class="fp__cat">{categoryLabel(category)}</span>
                <span class="fp__dot" aria-hidden="true" />
              </>
            )
          }
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
        </p>
        <h2 class="fp__title" id="fp-title">{post.data.title}</h2>
        <p class="fp__excerpt">{post.data.description}</p>
        <a class="btn btn--gold fp__cta" href={postHref(post)}>
          Read More<span class="visually-hidden">: {post.data.title}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .fp {
    background: var(--white);
    padding-block: 24px 0;
  }

  .fp__panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--navy-900);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .fp__media {
    position: relative;
    min-height: 560px;
  }

  .fp__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fp__badge {
    position: absolute;
    top: 24px;
    left: 24px;
    padding: 9px 16px;
    border-radius: var(--radius-xs);
    background: var(--gold-500);
    color: var(--gold-ink);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .fp__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px;
  }

  .fp__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    font-family: var(--font-ui);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
  }

  .fp__cat {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-500);
  }

  .fp__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
  }

  .fp__title {
    margin: 0 0 18px;
    font-size: clamp(30px, 2.6vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: #fff;
    text-wrap: balance;
  }

  .fp__excerpt {
    margin: 0 0 30px;
    max-width: 560px;
    font-family: var(--font-ui);
    font-size: 17px;
    line-height: 29px;
    color: rgba(255, 255, 255, 0.82);
  }

  .fp__cta {
    align-self: start;
    min-width: 200px;
    padding: 15px 34px;
  }

  @media (max-width: 1439px) {
    .fp__body {
      padding: 56px;
    }

    .fp__media {
      min-height: 480px;
    }
  }

  /* Stacked: the photo becomes a band above the copy, so it needs its own
     height rather than matching a column that no longer exists. */
  @media (max-width: 1000px) {
    .fp__panel {
      grid-template-columns: 1fr;
    }

    .fp__media {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .fp__body {
      padding: 48px 40px;
    }
  }

  @media (max-width: 650px) {
    .fp__media {
      aspect-ratio: 4 / 3;
    }

    .fp__body {
      padding: 32px 24px 36px;
    }

    .fp__badge {
      top: 16px;
      left: 16px;
    }

    .fp__excerpt {
      font-size: 16px;
      line-height: 28px;
    }

    .fp__cta {
      align-self: stretch;
    }
  }
</style>
