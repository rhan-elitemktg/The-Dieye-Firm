---
// RelatedPosts — the navy band of article cards that closes a blog post.
// The card itself is PostCard, shared with the Blog index grid.

import PostCard from "./PostCard.astro";
import type { Post } from "./blog";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="rp section" aria-labelledby="rp-title">
      <div class="container">
        <h2 class="rp__title" id="rp-title">Related Blog Posts</h2>

        <div class="rp__grid">
          {posts.map((post) => (
            <PostCard post={post} tone="navy" />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .rp {
    background: var(--navy-900);
  }

  .rp__title {
    margin: 0 0 56px;
    text-align: center;
    font-size: clamp(34px, 2.2785vw + 1.1994rem, 52px);
    line-height: 1.04;
    color: #fff;
  }

  .rp__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    align-items: stretch;
  }

  @media (max-width: 1439px) {
    .rp__grid {
      gap: 24px;
    }
  }

  /* The comp jumps straight from three columns to one; a two-up tier keeps the
     cards from ballooning on tablets. */
  @media (max-width: 1000px) {
    .rp__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .rp__title {
      margin-bottom: 40px;
    }
  }

  @media (max-width: 650px) {
    .rp__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
