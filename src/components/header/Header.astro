import InfoBar from "./InfoBar.astro";
import MainNav from "./MainNav.astro";
---

<header class="site-header">
  <InfoBar />
  <MainNav />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 200;
  }
</style>
