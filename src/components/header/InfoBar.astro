const portalHref = "/client-portal";

const socials = [
  { label: "Facebook", href: "https://www.facebook.com/thedieyefirm", path: "M15.12 5.32H17V2.14A26.11 26.11 0 0 0 14.26 2c-2.72 0-4.58 1.66-4.58 4.7v2.6H6.61v3.56h3.07V22h3.68v-9.14h3.06l.46-3.56h-3.52V7.05c0-1.03.28-1.73 1.76-1.73z" },
