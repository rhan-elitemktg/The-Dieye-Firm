---

<div class="infobar">
  <div class="container infobar__inner">
    <div class="infobar__left">
      {/* Deferred: "Serving Pearland · Houston · Sugar Land" location line */}
    </div>

    <div class="infobar__right">
      <a class="infobar__email" href={`mailto:${email}`}>
        <svg class="infobar__mail" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6zm-2 0-8 5-8-5h16zm0 12H4V8l8 5 8-5v10z" />
        </svg>
        <span>{email}</span>
      </a>

      <span class="infobar__divider" aria-hidden="true"></span>

      <ul class="infobar__socials">
        {socials.map((s) => (
          <li>
            <a href={s.href} class="infobar__soc" aria-label={s.label}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={s.path} />
              </svg>
            </a>
          </li>
        ))}
      </ul>

      <span class="infobar__divider" aria-hidden="true"></span>

      <a class="infobar__portal" href={portalHref}>Client Portal</a>
    </div>
  </div>
</div>

<style>
  .infobar {
    background: var(--navy-700);
    color: rgba(255, 255, 255, 0.86);
    font-family: var(--font-ui);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .infobar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
  }

  .infobar__right {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-left: auto;
  }

  /* Email */
  .infobar__email {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.86);
    font-size: 14px;
    line-height: 1;
    transition: color var(--dur-base) var(--ease-out);
  }

  .infobar__email:hover {
    color: var(--gold-500);
  }

  .infobar__mail {
    width: 17px;
    height: 17px;
    color: inherit; /* white, matches the email text (hovers to gold with the link) */
    flex: none;
  }

  /* Socials */
  .infobar__socials {
    display: flex;
    align-items: center;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .infobar__soc {
    display: inline-flex;
    color: rgba(255, 255, 255, 0.82);
    transition: color var(--dur-base) var(--ease-out);
  }

  .infobar__soc svg {
    width: 15px;
    height: 15px;
  }

  .infobar__soc:hover {
    color: var(--gold-500);
  }

  /* Divider */
  .infobar__divider {
    width: 1px;
    height: 16px;
    background: rgba(255, 255, 255, 0.22);
  }


  /* Client Portal */
  .infobar__portal {
    color: rgba(255, 255, 255, 0.86);
    font-size: 14px;
    line-height: 1;
    transition: color var(--dur-base) var(--ease-out);
  }

  .infobar__portal:hover {
    color: var(--gold-500);
  }

  /* Mobile — tighten, drop the email label, and match the mail glyph to the
     social icons with a divider between them. */
  @media (max-width: 650px) {
    .infobar__right {
      gap: 12px;
    }

    .infobar__email span {
      display: none;
    }

    .infobar__mail {
      width: 15px;
      height: 15px;
    }

    .infobar__socials {
      gap: 12px;
    }
  }
</style>
