---
// MainNav — the primary navigation bar of the sticky header.
// Zones: logo (left) · nav + actions (right).
// Nav labels/hrefs come from the live dieyelaw.com source; Family Law is a
// curated shortlist with a "View All" link to the full family-law index.
import { Image } from "astro:assets";
import { getLocationPages } from "../../sanity/locationPages";
import { getPracticeAreas } from "../../sanity/practiceAreas";
import logoLight from "../../assets/images/logo-light.png";
import { getFirmDetails } from "../../sanity/firmDetails";
import { getNavigation } from "../../sanity/navigation";

const { phone } = await getFirmDetails();

/* The rows UNDER each top-level item are editable — Site Settings →
   Navigation. The top-level rows themselves stay in the `nav` array below:
   their labels drive a MEASURED collapse breakpoint, one is deliberately
   hrefless, and two carry activeUnder prefixes. That is layout, not content. */
const { practiceAreaLinks, serviceAreas, aboutLinks, resourcesLinks } =
  await getNavigation();

/* Location pages whose path does not sit under their own location root — the
   two Pasadena orphans, /pasadena-child-support-attorney/ and
   /pasadena-family-law-mediation-attorney/. Prefix matching lights Service
   Areas up on the other 30 for free; these two would go dark without an
   explicit prefix.

   Derived from the collection rather than typed out, so the day the client
   publishes another stray page the nav follows it without an edit here. */
const locationPages = await getLocationPages();
const strayLocationPaths = [
  ...new Set(
    locationPages
      .filter((page) => !page.id.startsWith(page.data.location))
      .map((page) => `/${page.id.split("/")[0]}/`)
  ),
];

/* `href` is optional: "Resources" is a grouping label with no page behind it,
   so it renders as a button rather than a link. Everything else has a real
   destination, even where that destination isn't built yet. */
type NavItem = {
  label: string;
  href?: string;
  viewAll?: { label: string; href: string };
  items?: { label: string; href: string }[];
  /* Extra path prefixes that also light this item up. Two items need it, for
     the same reason: the pages they cover do not all live under the href.

     Practice Areas points at /practice-areas/ while the 32 pages it indexes
     live under /family-law/, and only six are in the flyout — without this the
     nav goes dark on the other twenty-six.

     Service Areas lists four roots, and 30 of the 32 location pages sit under
     one of them, so prefix matching covers them for free. The two that do not
     are the Pasadena pages hanging off the site root; they are derived from the
     collection below rather than typed here, so a future orphan needs no nav
     edit. */
  activeUnder?: string | string[];
};

const nav: NavItem[] = [
  {
    /* "About", not "About Us" — the row is width-constrained and the label
       reads the same. The URL keeps /about-us/.

       No "Papa Dieye" child any more: his page moved up to /about-us/, which
       is this item's own href, so the row would have been a second link to the
       parent. The parent is a real link at both widths — the mobile row splits
       the label from the chevron — so he is still one tap away.

       "The Dieye Difference" is gone too — that page folded into /about-us/
       and 301s there, so a nav row pointing at it would be a menu item that
       redirects. One child left; if it loses that one, drop `items` and this
       becomes a plain link rather than a dropdown with a single row. */
    label: "About",
    href: "/about-us/",
    items: aboutLinks,
  },
  {
    /* Points at the section index, /practice-areas/. Not /family-law/ — that
       is a practice-area page in its own right and appears in the flyout
       below like any other. */
    label: "Practice Areas",
    href: "/practice-areas/",
    activeUnder: "/family-law/",
    viewAll: { label: "View All +", href: "/practice-areas/" },
    items: practiceAreaLinks,
  },
  {
    label: "Service Areas",
    /* No index page for these, so the parent points at the first area rather
       than a URL that 404s — which it no longer does, now the section is
       built. Four rows stays four rows: like the Family Law flyout, this is a
       curated shortlist, and every location page carries its own full menu in
       the sidebar. */
    href: serviceAreas[0].href,
    activeUnder: strayLocationPaths,
    items: serviceAreas.map((area) => ({ label: area.navLabel, href: area.href })),
  },
  { label: "Testimonials", href: "/testimonials/" },
  {
    /* A grouping label, not a page — deliberately no href, so it renders as a
       button rather than a link (still focusable, since the flyout opens on
       :focus-within).

       Blog moved out to its own top-level item below, so these two are what
       Resources holds. Both are real sections of the live site that we have
       not rebuilt yet, so both 404 for now — knowingly, and tracked in
       HANDOFF.md. The comp's nav also lists "Free Guides"; that one is left
       out because it exists neither here nor on the live site, and inventing
       a route is worse than a short menu. */
    label: "Resources",
    items: resourcesLinks,
  },
  { label: "Blog", href: "/blog/" },
  /* No "Contact Us" row: the gold "Schedule a Consultation" button already
     goes to /contact-us/, in both the desktop actions and the mobile panel, so
     a nav item beside it was a second link to the same page. Dropping it buys
     the row width back. If the CTA ever changes destination, /contact-us/
     needs a home in the nav again. */
];

/* ---- Active-state helpers ----------------------------------------------
   Normalise to a trailing slash so "/family-law/" never prefix-matches
   something like "/family-lawyer/". A nav item is active when the current
   URL *is* its href or lives underneath it, so a child page such as
   /family-law/divorce/ lights up both "Family Law" and "Divorce". */
const normalise = (path: string) => (path.endsWith("/") ? path : `${path}/`);
const currentPath = normalise(Astro.url.pathname);

/* A hrefless item ("Resources") is never active in its own right — only
   through its children, which isBranchActive already covers. */
const isActive = (href?: string) => {
  if (!href) return false;
  const target = normalise(href);
  // "/" would prefix-match everything, so it only ever matches exactly.
  return target === "/" ? currentPath === "/" : currentPath.startsWith(target);
};

const isExact = (href?: string) => Boolean(href) && normalise(href!) === currentPath;

// True when the item itself, any extra prefix, or any of its children is active.
const asList = (v?: string | string[]) => (Array.isArray(v) ? v : v ? [v] : []);

const isBranchActive = (item: NavItem) =>
  isActive(item.href) ||
  asList(item.activeUnder).some((prefix) => isActive(prefix)) ||
  (item.items ?? []).some((sub) => isActive(sub.href));
---

<div class="mainnav">
  <div class="container mainnav__inner">
    <a class="mainnav__logo" href="/" aria-label="The Dieye Firm — home">
      <Image src={logoLight} alt="The Dieye Firm" format="webp" loading="eager" />
    </a>

    <nav class="mainnav__nav" aria-label="Primary">
      {nav.map((item) =>
        item.items ? (
          <div class:list={["navitem", "navitem--has-drop", { "is-active": isBranchActive(item) }]}>
            {/* A grouping label with no page behind it is a button, not a link
                — but it still has to be focusable, because the flyout opens on
                :focus-within. */}
            {item.href ? (
              <a
                class="navitem__link"
                href={item.href}
                aria-current={isExact(item.href) ? "page" : undefined}
              >
                {item.label}
                <span class="caret" aria-hidden="true">&#9662;</span>
              </a>
            ) : (
              <button class="navitem__link" type="button" aria-haspopup="true">
                {item.label}
                <span class="caret" aria-hidden="true">&#9662;</span>
              </button>
            )}
            <div class="nav-drop">
              <ul>
                {item.items.map((sub) => (
                  <li>
                    <a
                      href={sub.href}
                      class:list={[{ "is-active": isActive(sub.href) }]}
                      aria-current={isExact(sub.href) ? "page" : undefined}
                    >
                      {sub.label}
                    </a>
                  </li>
                ))}
              </ul>
              {item.viewAll && (
                <a
                  class:list={["nav-drop__all", { "is-active": isExact(item.viewAll.href) }]}
                  href={item.viewAll.href}
                >
                  {item.viewAll.label}
                </a>
              )}
            </div>
          </div>
        ) : (
          <div class:list={["navitem", { "is-active": isActive(item.href) }]}>
            <a
              class="navitem__link"
              href={item.href}
              aria-current={isExact(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </div>
        )
      )}
    </nav>

    <div class="mainnav__actions">
      {/* Now the only route to /contact-us/ in the header, so it carries the
          current-page state the removed nav item used to. */}
      <a
        class="btn btn--gold mainnav__cta"
        href="/contact-us/"
        aria-current={isExact("/contact-us/") ? "page" : undefined}
      >
        Contact Us
      </a>
      <span class="mainnav__sep" aria-hidden="true"></span>
      <a class="phonecta" href={phone.href}>
        <span class="phonecta__label">Financing Available</span>
        <span class="phonecta__num">{phone.display}</span>
      </a>
    </div>

    <a class="mainnav__phone-icon" href={phone.href} aria-label={`Call ${phone.display}`}>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" />
      </svg>
    </a>
    <button class="mainnav__burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
      <span></span><span></span><span></span>
    </button>
  </div>
</div>

<div class="mobile-menu" id="mobileMenu">
  <div class="mobile-menu__backdrop" data-close></div>
  <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Site menu">
    <div class="mobile-menu__head">
      <span class="mobile-menu__brand">Menu</span>
      <button class="mobile-menu__close" type="button" aria-label="Close menu" data-close>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav class="mobile-nav" aria-label="Mobile">
      <ul>
        {nav.map((item) =>
          item.items ? (
            <li class:list={["mobile-nav__item", { "is-expanded": isBranchActive(item) }]}>
              <div class="mobile-nav__row">
                {/* No page behind it, so the label toggles the group rather
                    than pretending to navigate. data-mobile-toggle marks both
                    this and the chevron for the script below. */}
                {item.href ? (
                  <a
                    class:list={["mobile-nav__link", { "is-active": isBranchActive(item) }]}
                    href={item.href}
                    aria-current={isExact(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                ) : (
                  <button
                    class="mobile-nav__link mobile-nav__link--group"
                    type="button"
                    data-mobile-toggle
                    aria-expanded={isBranchActive(item) ? "true" : "false"}
                  >
                    {item.label}
                  </button>
                )}
                <button
                  class="mobile-nav__toggle"
                  type="button"
                  data-mobile-toggle
                  aria-expanded={isBranchActive(item) ? "true" : "false"}
                  aria-label={`Toggle ${item.label} submenu`}
                >
                  <span class="mobile-nav__chevron" aria-hidden="true">&#9662;</span>
                </button>
              </div>
              <div class="mobile-nav__sub">
                <ul>
                  {item.items.map((sub) => (
                    <li>
                      <a
                        href={sub.href}
                        class:list={[{ "is-active": isActive(sub.href) }]}
                        aria-current={isExact(sub.href) ? "page" : undefined}
                      >
                        {sub.label}
                      </a>
                    </li>
                  ))}
                  {item.viewAll && (
                    <li>
                      <a
                        class:list={["mobile-nav__all", { "is-active": isExact(item.viewAll.href) }]}
                        href={item.viewAll.href}
                      >
                        {item.viewAll.label}
                      </a>
                    </li>
                  )}
                </ul>
              </div>
            </li>
          ) : (
            <li class="mobile-nav__item">
              <a
                class:list={["mobile-nav__link", "mobile-nav__link--solo", { "is-active": isActive(item.href) }]}
                href={item.href}
                aria-current={isExact(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          )
        )}
      </ul>
    </nav>

    <div class="mobile-menu__actions">
      <a
        class="btn btn--gold mobile-menu__cta"
        href="/contact-us/"
        aria-current={isExact("/contact-us/") ? "page" : undefined}
      >
        Contact Us
      </a>
      <a class="mobile-menu__phone" href={phone.href}>
        <span class="mobile-menu__phone-label">Financing Available</span>
        <span class="mobile-menu__phone-num">{phone.display}</span>
      </a>
    </div>
  </div>
</div>

<style>
  /* A shade deeper than the info bar above it, so the header reads as two
     tones rather than one slab. This matches the state the overlay header
     settles into once the page is scrolled. */
  .mainnav {
    background: var(--navy-900);
  }

  .mainnav__inner {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 100px;
  }

  /* Logo */
  .mainnav__logo {
    flex: none;
    display: inline-flex;
    align-items: center;
  }

  .mainnav__logo img {
    height: 60px;
    width: auto;
  }

  /* Nav */
  .mainnav__nav {
    display: flex;
    align-items: stretch;
    gap: 18px;
    height: 100px;
    margin-left: auto; /* logo stays left; nav + actions group on the right */
  }

  .navitem {
    position: relative;
    display: flex;
    align-items: center;
  }

  .navitem__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
    transition: color var(--dur-base) var(--ease-out);
  }

  /* "Resources" renders as a <button> because it has no page. Strip the UA's
     button chrome so it sits in the row indistinguishably from the links. */
  button.navitem__link {
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .navitem__link:hover {
    color: var(--gold-500);
  }

  /* Keep the parent lit while the pointer is anywhere in its dropdown. */
  .navitem--has-drop:hover .navitem__link,
  .navitem--has-drop:focus-within .navitem__link {
    color: var(--gold-500);
  }

  /* Current page — the top-level item (or its parent) stays gold. */
  .navitem.is-active .navitem__link {
    color: var(--gold-500);
  }

  .caret {
    font-size: 16px;
    color: var(--gold-500);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .navitem--has-drop:hover .caret {
    transform: translateY(2px);
  }

  /* Dropdown */
  .nav-drop {
    position: absolute;
    top: 100%;
    /* Left-aligned to the parent item rather than centred under it.
       The negative offset is the important bit: .navitem stretches the full
       100px bar height, so `top: 100%` lands ~35px below the label's baseline
       and the menu reads as detached. The header is transparent over the hero,
       so there's no bar edge to sit under — only the text. This pulls the
       panel back up to ~15px below the label. */
    left: 0;
    transform: translateY(4px);
    margin-top: -20px;
    min-width: 232px;
    background: var(--white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: 8px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
    z-index: 10;
  }

  /* Invisible bridge so hover doesn't drop through the gap. Sized to the
     margin-top plus the 4px enter offset, or the menu closes mid-travel. */
  .nav-drop::before {
    content: "";
    position: absolute;
    top: -8px;
    left: 0;
    right: 0;
    height: 8px;
  }

  .navitem--has-drop:hover .nav-drop,
  .navitem--has-drop:focus-within .nav-drop {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-drop ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-drop a {
    display: block;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--ink-700);
    white-space: nowrap;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .nav-drop a:hover {
    background: var(--bone-100);
    color: var(--navy-700);
  }

  /* Current page inside a dropdown */
  .nav-drop a.is-active {
    background: var(--bone-100);
    color: var(--gold-600);
    font-weight: 600;
  }

  .nav-drop a.nav-drop__all.is-active {
    background: var(--bone-100);
  }

  /* "View all" footer link inside a dropdown.
     Selector matches .nav-drop a specificity so these overrides win. */
  .nav-drop a.nav-drop__all {
    margin-top: 6px;
    padding: 11px 14px;
    border-radius: 0;
    border-top: 1px solid var(--bone-300);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--gold-600);
  }

  .nav-drop a.nav-drop__all:hover {
    background: transparent;
    color: var(--navy-700);
  }

  /* Actions */
  .mainnav__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: none;
  }

  .mainnav__sep {
    width: 1px;
    height: 42px;
    background: rgba(196, 162, 76, 0.45);
    flex: none;
  }

  .phonecta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    line-height: 1;
  }

  .phonecta__label {
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-500);
  }

  .phonecta__num {
    font-family: var(--font-ui);
    font-size: clamp(20px, 0.2532vw + 1.1472rem, 22px);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #fff;
    transition: color var(--dur-base) var(--ease-out);
  }

  .phonecta:hover .phonecta__num {
    color: var(--gold-500);
  }

  /* Mobile phone icon — hidden until the nav collapses */
  .mainnav__phone-icon {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--gold-500);
    transition: color var(--dur-base) var(--ease-out);
  }

  .mainnav__phone-icon:hover {
    color: #fff;
  }

  .mainnav__phone-icon svg {
    width: 24px;
    height: 24px;
  }

  /* Hamburger — hidden until the nav collapses */
  .mainnav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 0;
    padding: 0;
  }

  .mainnav__burger span {
    display: block;
    width: 26px;
    height: 2px;
    margin-inline: auto;
    background: #fff;
    border-radius: 2px;
  }

  /* ===== Mobile menu (slide-out) ===== */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 300;
    visibility: hidden;
    transition: visibility 0s linear var(--dur-slow);
  }

  .mobile-menu.is-open {
    visibility: visible;
    transition-delay: 0s;
  }

  .mobile-menu__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 36, 56, 0.5);
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .mobile-menu.is-open .mobile-menu__backdrop {
    opacity: 1;
  }

  .mobile-menu__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(360px, 86vw);
    display: flex;
    flex-direction: column;
    background: var(--navy-700);
    box-shadow: var(--shadow-xl);
    transform: translateX(100%);
    transition: transform var(--dur-slow) var(--ease-out);
    overflow-y: auto;
  }

  .mobile-menu.is-open .mobile-menu__panel {
    transform: translateX(0);
  }

  .mobile-menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .mobile-menu__brand {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-500);
  }

  .mobile-menu__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-right: -8px;
    background: transparent;
    border: 0;
    color: #fff;
  }

  .mobile-menu__close svg {
    width: 24px;
    height: 24px;
  }

  .mobile-nav {
    flex: 1;
    padding: 4px 0;
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-nav__item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-nav__row {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
  }

  .mobile-nav__link {
    display: block;
    flex: 1;
    padding: 16px 24px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    transition: color var(--dur-base) var(--ease-out);
  }

  /* Same reset as the desktop trigger. Left-aligned because a button centres
     its text by default and every row beside it is left-aligned. */
  button.mobile-nav__link {
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
  }

  .mobile-nav__link:hover,
  .mobile-nav__link.is-active {
    color: var(--gold-500);
  }

  .mobile-nav__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    align-self: stretch;
    background: transparent;
    border: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--gold-500);
  }

  .mobile-nav__chevron {
    font-size: 25px;
    line-height: 1;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .mobile-nav__item.is-expanded .mobile-nav__chevron {
    transform: rotate(180deg);
  }

  /* Accordion sub-menu — animated via grid-template-rows */
  .mobile-nav__sub {
    display: grid;
    grid-template-rows: 0fr;
    background: rgba(0, 0, 0, 0.16);
    transition: grid-template-rows var(--dur-slow) var(--ease-out);
  }

  .mobile-nav__sub > ul {
    overflow: hidden;
  }

  .mobile-nav__item.is-expanded > .mobile-nav__sub {
    grid-template-rows: 1fr;
  }

  .mobile-nav__sub a {
    display: block;
    padding: 12px 24px 12px 36px;
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.78);
    transition: color var(--dur-base) var(--ease-out);
  }

  .mobile-nav__sub a:hover,
  .mobile-nav__sub a.is-active {
    color: var(--gold-500);
  }

  .mobile-nav__sub a.is-active {
    font-weight: 700;
  }

  .mobile-nav__sub a.mobile-nav__all {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--gold-500);
  }

  .mobile-menu__actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 22px 24px 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .mobile-menu__cta {
    justify-content: center;
    width: 100%;
    padding: 10px 22px;
  }

  .mobile-menu__phone {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .mobile-menu__phone-label {
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-500);
    line-height: 1.25;
  }

  .mobile-menu__phone-num {
    font-family: var(--font-ui);
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    transition: color var(--dur-base) var(--ease-out);
  }

  .mobile-menu__phone:hover .mobile-menu__phone-num {
    color: var(--gold-500);
  }

  /* Never render the mobile menu on desktop */
  @media (min-width: 1160px) {
    .mobile-menu {
      display: none;
    }
  }

  /* Small Desktop — shrink so the full row still fits down to the collapse.

     The ceiling is 1520, not the usual 1439, and the reason is counter-
     intuitive: --container-pad jumps from 40px to 100px at 1440, so the
     content box gets NARROWER as the viewport gets wider — 1359px at 1439,
     1240px at 1440. The header is the only row wide enough to notice, and the
     full-size nav needs ~1258px, so it overflows from 1440 until the viewport
     has grown enough to pay back the extra gutter (~1458). Holding the compact
     tier to 1520 covers that band with room to spare.

     Same class of exception as the 1160px collapse documented in AGENTS.md,
     and for the same reason: this row's width is driven by its contents, not
     by the layout grid. */
  @media (max-width: 1520px) {
    .mainnav__inner { gap: 20px; }
    .mainnav__nav { gap: 15px; }
    .navitem__link { font-size: 13px; letter-spacing: 0.03em; gap: 4px; }
    .mainnav__logo img { height: 52px; }
    .mainnav__actions { gap: 14px; }
    .mainnav__cta { padding: 8px 16px; font-size: 12.5px; letter-spacing: 0.04em; }
    .caret { font-size: 14px; }
    .mainnav__sep { display: none; }
    .phonecta__label { display: none; }
    .phonecta__num { font-size: 17px; }
  }

  /* Header-specific collapse at 1160px (an intentional exception to the global
     1000px tablet breakpoint): logo + nav + CTA + phone measure 998px, which
     needs 1078px of viewport once the 40px gutters are paid.

     The ~80px of slack is deliberate. This number is a MEASUREMENT and it has
     moved three times already, every time because a label changed rather than
     because anything was added or removed: 1200 -> 1260 as "Blog" became
     "Resources" and "Family Law" became "Practice Areas", then -> 1160 once
     "About Us" became "About", the "Contact Us" item went, and the CTA was
     shortened to "Contact Us". Holding it above the measured need means the
     next label change costs a re-measure rather than an overflow bug.
     Re-measure after any label change rather than assuming this still holds. */
  @media (max-width: 1159px) {
    .mainnav__nav,
    .mainnav__actions {
      display: none;
    }

    .mainnav__phone-icon {
      display: inline-flex;
      margin-left: auto; /* push the phone + burger group to the right */
    }

    .mainnav__burger {
      display: flex;
    }

    .mainnav__inner {
      min-height: 85px;
      gap: 10px;
    }

    .mainnav__logo img {
      height: 52px;
    }
  }
</style>

<script>
  const menu = document.getElementById("mobileMenu");
  const burger = document.querySelector(".mainnav__burger");

  if (menu && burger) {
    const openMenu = () => {
      menu.classList.add("is-open");
      burger.setAttribute("aria-expanded", "true");
      document.documentElement.style.overflow = "hidden";
    };
    const closeMenu = () => {
      menu.classList.remove("is-open");
      burger.setAttribute("aria-expanded", "false");
      document.documentElement.style.overflow = "";
    };

    burger.addEventListener("click", () => {
      menu.classList.contains("is-open") ? closeMenu() : openMenu();
    });

    menu.querySelectorAll("[data-close]").forEach((el) =>
      el.addEventListener("click", closeMenu)
    );

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.classList.contains("is-open")) closeMenu();
    });

    /* Accordion sub-menus. A group with no page of its own ("Resources") has
       two toggles on the row — the label and the chevron — so the new state is
       written to every toggle in that row, not just the one clicked. */
    menu.querySelectorAll("[data-mobile-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const li = btn.closest(".mobile-nav__item");
        if (!li) return;
        const expanded = li.classList.toggle("is-expanded");
        li.querySelectorAll("[data-mobile-toggle]").forEach((t) =>
          t.setAttribute("aria-expanded", expanded ? "true" : "false")
        );
      });
    });

    // Close the menu when any real link is tapped
    menu.querySelectorAll("a[href]").forEach((a) =>
      a.addEventListener("click", closeMenu)
    );
  }
</script>
