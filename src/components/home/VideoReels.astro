---
// Video Reels — "Family Law, Explained". A scroll-snap carousel of vertical
// Wistia shorts: four per view on desktop, two on tablet, one on mobile.
// Cards open the shared VideoModal (rendered in Layout.astro) at 9:16.

import { Image } from "astro:assets";
import birdGold from "../../assets/images/logo-bird-gold.png";
import posterPearland from "../../assets/images/reels/papa-reel-pearland.jpg";
import posterStorefront from "../../assets/images/reels/papa-reel-storefront.jpg";
import posterSky from "../../assets/images/reels/papa-reel-sky.jpg";
import posterPortico from "../../assets/images/reels/papa-reel-portico.jpg";

/* Posters are shot portraits rather than Wistia's auto-generated stills — the
   Wistia frames are mid-sentence and carry burned-in social captions, which
   fought the card's own title. Four posters cover six videos; the two repeats
   are placed so a duplicate never appears twice in the same view at any
   breakpoint.

   Titles are curated here rather than taken from the Wistia API for the same
   reason the About section does it: the API titles carry em dashes, emoji and
   hashtag phrasing ("...Divorced…But Here's Why You Might Want One 👀"). */
const reels = [
  { id: "lfabb7o3i4", title: "What judges really look at in custody", poster: posterPearland },
  { id: "bu44cm272t", title: "Dating before your divorce is final", poster: posterStorefront },
  { id: "hf0aygaziw", title: "How fast can you get divorced in Texas?", poster: posterSky },
  { id: "9d4t97fstd", title: "Is legal separation a thing in Texas?", poster: posterPortico },
  { id: "bc4fv4m4oz", title: "Sometimes \"I'm done\" is all it takes", poster: posterPearland },
  { id: "aed5yc9gn0", title: "Do you really need a divorce lawyer?", poster: posterStorefront },
];

/* Runtime comes from Wistia at build time, wrapped so an outage degrades to a
   card with no duration pill rather than failing the build. */
const videos = await Promise.all(
  reels.map(async (reel) => {
    const mediaUrl = "https://home.wistia.com/medias/" + reel.id;
    const oembedUrl = "https://fast.wistia.com/oembed?url=" + encodeURIComponent(mediaUrl);

    let duration: number | null = null;

    try {
      const response = await fetch(oembedUrl);
      if (response.ok) {
        const data = await response.json();
        duration = typeof data.duration === "number" ? data.duration : null;
      }
    } catch (error) {
      duration = null;
    }

    const runtime = duration
      ? `${Math.floor(duration / 60)}:${String(Math.round(duration % 60)).padStart(2, "0")}`
      : null;

    return {
      ...reel,
      runtime,
      label: runtime ? `Play video: ${reel.title} (${runtime})` : `Play video: ${reel.title}`,
    };
  }),
);
---

<section class="reels section" aria-labelledby="reels-title" data-reels>
  <div class="container">
    <header class="reels__head">
      <p class="reels__eyebrow">
        <Image src={birdGold} alt="" width={70} format="webp" loading="lazy" decoding="async" />
        <span>Watch &amp; Learn</span>
      </p>
      <h2 class="reels__title" id="reels-title">Family Law, <em>Explained</em></h2>
    </header>

    <ul
      class="reels__track"
      tabindex="0"
      role="region"
      aria-label="Short family law videos"
      data-reels-track
    >
      {videos.map((video) => (
        <li class="reels__slide">
          <button
            class="reel"
            type="button"
            aria-label={video.label}
            data-video-open
            data-wistia-id={video.id}
            data-video-title={video.title}
            data-video-aspect="9/16"
          >
            <Image
              class="reel__poster"
              src={video.poster}
              alt=""
              widths={[220, 300, 420, 540]}
              sizes="(max-width: 650px) 46vw, (max-width: 1000px) 30vw, 24vw"
              format="webp"
              quality={78}
              loading="lazy"
              decoding="async"
            />
            <span class="reel__scrim" aria-hidden="true"></span>
            {/* Play badge and title share one centred column so the title
                always sits directly beneath the badge, whatever its length. */}
            <span class="reel__body">
              <span class="reel__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              </span>
              <span class="reel__title">{video.title}</span>
            </span>
            {video.runtime && <span class="reel__duration">{video.runtime}</span>}
          </button>
        </li>
      ))}
    </ul>

    {/* One dot per video is rendered up front — the most pages there can ever
        be, at one-per-view — and the script hides the surplus once it knows
        how many fit. Rendering them here rather than creating them in JS is
        what keeps them inside Astro's scoped styles. */}
    <div class="reels__dots" data-reels-dots>
      {videos.map((_, i) => (
        <button class="reels__dot" type="button" aria-label={`Show videos, page ${i + 1}`} hidden />
      ))}
    </div>

    <div class="reels__cta">
      <a class="btn btn--gold" href="/videos/">View More Videos</a>
    </div>
  </div>
</section>

<style>
  /* A cool near-white fading to pure white. Specified directly rather than
     from the warm bone palette — this section deliberately reads cooler than
     the bands around it. */
  .reels {
    --reels-gap: 24px;
    background: linear-gradient(180deg, #f7f9fa 0%, #ffffff 100%);
  }

  /* ---- Head ---- */
  .reels__head {
    margin-bottom: 44px;
    text-align: center;
  }

  .reels__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy-700);
  }

  .reels__eyebrow img {
    width: 30px;
    height: auto;
    flex: none;
  }

  .reels__title {
    font-size: clamp(34px, 2.2785vw + 1.1994rem, 52px);
    line-height: 1.12;
  }

  .reels__title em {
    font-style: italic;
    color: var(--gold-600);
  }

  /* ---- Track ---- */
  /* Same scroll-snap carousel as the awards strip and testimonials: the slides
     are real scroll children, so touch and keyboard paging come for free. */
  .reels__track {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: var(--reels-gap);
    list-style: none;
    margin: 0;
    /* The scrollport clips on every side, so the inline padding gives the
       cards' shadows somewhere to land at the track's edges. The negative
       margin cancels it so the cards still line up with the page container,
       and scroll-padding moves the snapport in to match — without it the
       first card can't rest at scrollLeft 0 and the track jumps on load. */
    padding: 10px 16px 22px;
    margin-inline: -16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .reels__track::-webkit-scrollbar {
    display: none;
  }

  .reels__track:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--gold-500) 55%, transparent);
    outline-offset: 6px;
    border-radius: var(--radius-sm);
  }

  .reels__slide {
    flex: 0 0 calc((100% - 3 * var(--reels-gap)) / 4);
    display: flex;
    scroll-snap-align: start;
  }

  /* ---- Card ---- */
  .reel {
    position: relative;
    display: block;
    width: 100%;
    /* The source videos are 720x1280, so the card matches them exactly and the
       poster never has to crop. */
    aspect-ratio: 9 / 16;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--navy-900);
    box-shadow: 0 10px 24px -14px rgba(21, 33, 46, 0.22);
    text-align: center;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .reel:hover {
    transform: translateY(-4px);
  }

  .reel__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--photo-filter);
  }

  /* Weighted to the lower half, where the title sits. */
  .reel__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 36, 56, 0) 30%,
      rgba(15, 36, 56, 0.28) 55%,
      rgba(15, 36, 56, 0.78) 100%
    );
  }

  /* Anchored to the lower half rather than dead centre so the title has room
     beneath the badge without crowding the bottom edge. */
  .reel__body {
    position: absolute;
    right: 18px;
    bottom: 26px;
    left: 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .reel__play {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: var(--radius-pill);
    background: var(--gold-500);
    color: var(--navy-900);
    transition:
      background var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .reel:hover .reel__play {
    background: color-mix(in srgb, var(--gold-500) 86%, #fff);
    transform: scale(1.06);
  }

  .reel__play svg {
    width: 24px;
    height: 24px;
    margin-left: 3px;
  }

  /* Two lines reserved so the swap to Source Serif 4 can't re-wrap a title and
     shift the badge above it, and so badges line up across a row. */
  .reel__title {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.6em;
    font-family: var(--font-serif);
    font-size: clamp(15px, 0.6329vw + 0.6373rem, 20px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    color: #fff;
  }

  /* Top corner, not bottom: the title block owns the lower half and a
     bottom-right pill runs into the end of a two-line title. */
  .reel__duration {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    background: rgba(15, 36, 56, 0.72);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  /* ---- Dots ---- */
  .reels__dots {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin-top: 10px;
  }

  .reels.is-scrollable .reels__dots {
    display: flex;
  }

  /* The button is a 24px tap target; the visible dot is the ::before. */
  .reels__dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    background: transparent;
    border: 0;
  }

  /* display:grid would otherwise defeat the hidden attribute. */
  .reels__dot[hidden] {
    display: none;
  }

  .reels__dot::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--bone-400);
    transition:
      background var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .reels__dot:hover::before {
    background: var(--gold-300);
  }

  .reels__dot[aria-current="true"]::before {
    background: var(--navy-700);
    transform: scale(1.3);
  }

  /* ---- CTA ---- */
  .reels__cta {
    margin-top: 34px;
    text-align: center;
  }

  .reels__cta .btn {
    min-width: 260px;
    padding: 18px 34px;
  }

  /* Small Desktop */
  @media (max-width: 1439px) {
    .reels {
      --reels-gap: 20px;
    }
  }

  /* Tablet — three per view. */
  @media (max-width: 1000px) {
    .reels__head {
      margin-bottom: 36px;
    }

    .reels__slide {
      flex: 0 0 calc((100% - 2 * var(--reels-gap)) / 3);
    }

    .reel__body {
      gap: 14px;
    }

    .reel__play {
      width: 52px;
      height: 52px;
    }

    .reel__play svg {
      width: 22px;
      height: 22px;
    }
  }

  /* Mobile — two per view. The cards get narrow here, so the badge and title
     step down with them rather than filling the whole frame. */
  @media (max-width: 650px) {
    .reels {
      --reels-gap: 14px;
    }

    .reels__eyebrow {
      font-size: 13px;
      letter-spacing: 0.14em;
    }

    .reels__slide {
      flex: 0 0 calc((100% - var(--reels-gap)) / 2);
    }

    .reel__body {
      right: 12px;
      bottom: 16px;
      left: 12px;
      gap: 10px;
    }

    .reel__play {
      width: 42px;
      height: 42px;
    }

    .reel__play svg {
      width: 18px;
      height: 18px;
      margin-left: 2px;
    }

    .reel__duration {
      top: 10px;
      right: 10px;
      padding: 4px 8px;
      font-size: 11px;
    }

    .reels__cta {
      margin-top: 26px;
    }

    .reels__cta .btn {
      width: 100%;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-reels]");
  const track = section?.querySelector<HTMLElement>("[data-reels-track]");
  const dots = section?.querySelector<HTMLElement>("[data-reels-dots]");

  if (section && track && dots) {
    /* JS smooth scrolling ignores the `scroll-behavior: auto !important` that
       global.css sets under prefers-reduced-motion, so the preference has to be
       read and applied by hand. */
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const behavior = (): ScrollBehavior => (reducedMotion.matches ? "auto" : "smooth");

    /* Derive how many cards are on screen from their measured width rather
       than hard-coding per-breakpoint counts, so the dot count stays correct
       if the sizing changes. */
    const metrics = () => {
      const items = Array.from(track.children) as HTMLElement[];
      const styles = getComputedStyle(track);
      const gap = parseFloat(styles.columnGap) || 0;
      // clientWidth includes the track's inline padding, which exists only to
      // catch the cards' shadows. Measure against the content box.
      const viewport =
        track.clientWidth -
        (parseFloat(styles.paddingLeft) || 0) -
        (parseFloat(styles.paddingRight) || 0);
      const stride = (items[0]?.getBoundingClientRect().width ?? 0) + gap;
      const perView = stride > 0 ? Math.max(1, Math.round((viewport + gap) / stride)) : 1;
      return { perView, pageWidth: perView * stride, pages: Math.ceil(items.length / perView) };
    };

    const dotEls = Array.from(dots.querySelectorAll<HTMLButtonElement>(".reels__dot"));

    const syncActive = () => {
      const { pageWidth, pages } = metrics();
      // The final page clamps flush-right rather than scrolling a full page
      // width, so rounding alone would leave the last dot unreachable.
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
      const active = atEnd
        ? pages - 1
        : pageWidth > 0
          ? Math.min(pages - 1, Math.round(track.scrollLeft / pageWidth))
          : 0;
      dotEls.forEach((dot, i) =>
        dot.setAttribute("aria-current", i === active ? "true" : "false"),
      );
    };

    dotEls.forEach((dot, i) =>
      dot.addEventListener("click", () =>
        track.scrollTo({ left: i * metrics().pageWidth, behavior: behavior() }),
      ),
    );

    const render = () => {
      // 1px of slack absorbs sub-pixel rounding in the scroll metrics.
      const scrollable = track.scrollWidth > track.clientWidth + 1;
      section.classList.toggle("is-scrollable", scrollable);

      const pages = scrollable ? metrics().pages : 0;
      dotEls.forEach((dot, i) => (dot.hidden = i >= pages));

      if (scrollable) syncActive();
    };

    track.addEventListener("scroll", syncActive, { passive: true });
    new ResizeObserver(render).observe(track);

    render();
  }
</script>
