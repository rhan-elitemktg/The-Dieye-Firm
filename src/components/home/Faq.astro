---
// FAQ — accordion of common Texas family law questions.
//
// Built on native <details name="faq">, which gives exclusive open/close
// behaviour, keyboard support, and find-in-page for free. No JS at all.

import { Image } from "astro:assets";
import birdGold from "../../assets/images/logo-bird-gold.png";
import headshot from "../../assets/images/papa-headshot.jpg";

const faqs = [
  {
    q: "What is the difference between a contested and an uncontested case?",
    a: "A contested case means the spouses can't agree on one or more issues, which may require document exchanges, hearings, and mediation before it's finalized. An uncontested case means you've agreed on everything, from property to children's issues, and is usually resolved quickly.",
  },
  {
    q: "What is the difference between joint custody and sole custody?",
    a: "In Texas, joint managing conservatorship is the default: both parents share rights and duties, though some rights may go to one parent. Sole custody gives one parent the exclusive right to make most decisions, and is only granted when joint custody wouldn't serve the child's best interest.",
  },
  {
    q: "When is a party entitled to receive spousal support?",
    a: "Texas courts are generally reluctant to award spousal support. It's typically available only when the marriage lasted ten years or longer and the requesting spouse can't meet their minimum reasonable needs, or in cases involving family violence or a qualifying disability.",
  },
  {
    q: "What factors does the court look at when awarding custody?",
    a: "The paramount consideration is always the best interest of the child. Courts weigh the child's age, the relationship with each parent, the parents' ability to cooperate, any abuse or neglect, and even the child's preference. There's no fixed limit on what they may consider.",
  },
  {
    q: "How much spousal support will the court order?",
    a: "Support can't exceed 20% of the paying spouse's gross income or $5,000 per month, whichever is lower. Duration depends on the length of the marriage: up to five years for marriages of 10 to 20 years, seven years for 20 to 30 years, and up to ten years for marriages over 30 years.",
  },
  {
    q: "How much is child support if it is ordered?",
    a: "Texas uses a formula based on the paying parent's gross income and the number of children. The possession schedule and the other parent's income don't factor in, because child support is the right of the child, and the formula is a guideline.",
  },
];

/* FAQPage structured data, generated from the same source as the markup so
   the two can't drift apart. */
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<section class="faq section" aria-labelledby="faq-title">
  <div class="container">
    <header class="faq__head">
      <p class="faq__eyebrow">
        <Image src={birdGold} alt="" width={70} format="webp" loading="lazy" decoding="async" />
        <span>Frequently Asked Questions</span>
      </p>
      <h2 class="faq__title" id="faq-title">
        Answers to the Most Commonly <em>Asked Questions</em>
      </h2>
    </header>

    <ul class="faq__list">
      {faqs.map((item, i) => (
        <li>
          <details class="faq__item" name="faq" open={i === 0}>
            <summary class="faq__q">
              <span>{item.q}</span>
              {/* A plus that rotates a quarter turn into a cross on open. */}
              <span class="faq__marker" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path
                    d="M12 5v14M5 12h14"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
            </summary>
            <div class="faq__a">
              <p>{item.a}</p>
            </div>
          </details>
        </li>
      ))}
    </ul>

    <aside class="faq__ask">
      <Image
        class="faq__ask-avatar"
        src={headshot}
        alt=""
        width={104}
        format="webp"
        quality={82}
        loading="lazy"
        decoding="async"
      />
      <div class="faq__ask-copy">
        <p class="faq__ask-title">Have another question?</p>
        <p class="faq__ask-text">
          Papa is happy to answer it personally. No pressure, no obligation.
        </p>
      </div>
      <a class="btn btn--gold faq__ask-cta" href="/contact-us/">Schedule a Consultation</a>
    </aside>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq {
    background: var(--white);
    /* Lets the open/close transition interpolate to `auto` height. Scoped
       here rather than on :root so it only affects this accordion. */
    interpolate-size: allow-keywords;
  }

  /* ---- Head ---- */
  .faq__head {
    max-width: 820px;
    margin: 0 auto 54px;
    text-align: center;
  }

  .faq__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy-700);
  }

  .faq__eyebrow img {
    width: 30px;
    height: auto;
    flex: none;
  }

  .faq__title {
    font-size: clamp(34px, 2.2785vw + 1.1994rem, 52px);
    line-height: 1.12;
  }

  /* Block so the italic phrase always takes its own line rather than
     wrapping wherever the measure happens to land. */
  .faq__title em {
    display: block;
    font-style: italic;
    color: var(--gold-600);
  }

  /* ---- List ---- */
  .faq__list {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--bone-300);
  }

  .faq__item {
    border-bottom: 1px solid var(--bone-300);
  }

  /* ---- Question ---- */
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 26px 0;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: clamp(18px, 0.3797vw + 0.9707rem, 21px);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: var(--tracking-tight);
    color: var(--navy-700);
    /* Suppress the native disclosure triangle in every engine. */
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--gold-500) 55%, transparent);
    outline-offset: 4px;
    border-radius: var(--radius-xs);
  }

  .faq__marker {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    color: var(--gold-500);
  }

  .faq__marker svg {
    width: 20px;
    height: 20px;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .faq__item[open] .faq__marker svg {
    transform: rotate(45deg);
  }

  /* ---- Answer ---- */
  /* ::details-content is the browser's own wrapper around everything after
     the <summary>, which is what makes a native <details> animatable without
     JS. content-visibility needs allow-discrete so the closed state waits for
     the height to finish collapsing instead of snapping away at frame one.
     Engines without ::details-content just open and close instantly. */
  .faq__item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size var(--dur-slow) var(--ease-out),
      content-visibility var(--dur-slow) var(--ease-out) allow-discrete;
  }

  .faq__item[open]::details-content {
    block-size: auto;
  }

  .faq__a {
    padding-bottom: 28px;
  }

  .faq__a p {
    max-width: 960px;
    margin: 0;
    color: var(--ink-500);
  }

  /* ---- Ask card ---- */
  .faq__ask {
    display: flex;
    align-items: center;
    gap: 20px;
    max-width: 1000px;
    margin: 40px auto 0;
    padding: 22px 28px;
    border: 1px solid var(--bone-300);
    border-radius: var(--radius-md);
  }

  .faq__ask-avatar {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--gold-500);
  }

  .faq__ask-copy {
    min-width: 0;
  }

  .faq__ask-title {
    margin-bottom: 2px;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--navy-700);
  }

  .faq__ask-text {
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-500);
  }

  .faq__ask-cta {
    flex: none;
    margin-left: auto;
    padding: 18px 30px;
  }

  /* Tablet */
  @media (max-width: 1000px) {
    .faq__head {
      margin-bottom: 40px;
    }
  }

  /* Mobile */
  @media (max-width: 650px) {
    .faq__eyebrow {
      font-size: 13px;
      letter-spacing: 0.14em;
    }

    .faq__q {
      gap: 18px;
      padding: 20px 0;
    }

    .faq__a {
      padding-bottom: 22px;
    }

    .faq__a p {
      font-size: 16px;
      line-height: 27px;
    }

    /* Stack: avatar and copy on one row, the CTA full width beneath. */
    .faq__ask {
      flex-wrap: wrap;
      gap: 16px;
      padding: 22px 20px;
    }

    .faq__ask-cta {
      width: 100%;
      margin-left: 0;
    }
  }

  /* The global reduced-motion rule covers *, ::before and ::after, but not
     ::details-content, so it needs stopping here. */
  @media (prefers-reduced-motion: reduce) {
    .faq__item::details-content {
      transition: none;
    }
  }
</style>
