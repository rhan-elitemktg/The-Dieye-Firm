---
// FAQ — accordion of common Texas family law questions.
//
// Built on native <details name="faq">, which gives exclusive open/close
// behaviour, keyboard support, and find-in-page for free. No JS at all.
//
// Two pages render this. The homepage gets the six condensed answers below;
// /faq/ passes the nine the client publishes, in their own words, and drops
// the section head because that page already opened with its own h1. Props
// rather than a clone or a move to a shared directory, exactly as BlogHeader
// took `eyebrow`: if a third page ever wants it, it graduates.

import { Image } from "astro:assets";
import birdGold from "../../assets/images/logo-bird-gold.png";
import headshot from "../../assets/images/papa-headshot.jpg";
import { getHomeFaqs, type FaqItem } from "../../sanity/faqs";
import { getHomePage } from "../../sanity/homePage";
const copy = (await getHomePage()).faq;

interface Props {
  /* Defaults to the homepage's six, so <Faq /> is unchanged. */
  items?: FaqItem[];
  /* The eyebrow + h2 above the list. /faq/ passes false: its own page header
     is already a kicker and a heading, and a second pair reads as a stutter. */
  head?: boolean;
}

const { items, head = true } = Astro.props;

/* The six condensed answers, unless a page passes its own set. /faq/ passes the
   nine full ones - the two wordings are deliberately different, and the schema
   header says why. */
const faqs = items ?? (await getHomeFaqs());

/* FAQPage structured data, generated from the same source as the markup so
   the two can't drift apart. */
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<section
  class:list={["faq", "section", { "faq--flush": !head }]}
  aria-labelledby={head ? "faq-title" : undefined}
  aria-label={head ? undefined : "Frequently asked questions"}
>
  <div class="container">
    {head && (
      <header class="faq__head">
        <p class="faq__eyebrow">
          <Image src={birdGold} alt="" width={70} format="webp" loading="lazy" decoding="async" />
          <span>{copy.eyebrow}</span>
        </p>
        <h2 class="faq__title" id="faq-title">
          {copy.headingLead}{" "}{copy.headingAccent && <em>{copy.headingAccent}</em>}
        </h2>
      </header>
    )}

    <ul class="faq__list">
      {faqs.map((item, i) => (
        <li>
          <details class="faq__item" name="faq" open={i === 0}>
            <summary class="faq__q">
              <span>{item.q}</span>
              {/* A plus that rotates a quarter turn into a cross on open. */}
              <span class="faq__marker" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path
                    d="M12 5v14M5 12h14"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
            </summary>
            <div class="faq__a">
              <p>{item.a}</p>
            </div>
          </details>
        </li>
      ))}
    </ul>

    <aside class="faq__ask">
      <Image
        class="faq__ask-avatar"
        src={headshot}
        alt=""
        width={104}
        format="webp"
        quality={82}
        loading="lazy"
        decoding="async"
      />
      <div class="faq__ask-copy">
        <p class="faq__ask-title">Have another question?</p>
        <p class="faq__ask-text">
          Papa is happy to answer it personally. No pressure, no obligation.
        </p>
      </div>
      <a class="btn btn--gold faq__ask-cta" href="/contact-us/">Schedule a Consultation</a>
    </aside>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq {
    background: var(--white);
    /* Lets the open/close transition interpolate to `auto` height. Scoped
       here rather than on :root so it only affects this accordion. */
    interpolate-size: allow-keywords;
  }

  /* Without the section head, the page header directly above already carries
     the leading space. 8px matches VideoGrid, so /faq/ and /video-center/ open
     on the same rhythm under an identical BlogHeader. */
  .faq--flush {
    padding-block-start: 8px;
  }

  /* ---- Head ---- */
  .faq__head {
    max-width: 820px;
    margin: 0 auto 54px;
    text-align: center;
  }

  .faq__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy-700);
  }

  .faq__eyebrow img {
    width: 30px;
    height: auto;
    flex: none;
  }

  .faq__title {
    font-size: clamp(34px, 2.2785vw + 1.1994rem, 52px);
    line-height: 1.12;
  }

  /* Block so the italic phrase always takes its own line rather than
     wrapping wherever the measure happens to land. */
  .faq__title em {
    display: block;
    font-style: italic;
    color: var(--gold-600);
  }

  /* ---- List ---- */
  .faq__list {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--bone-300);
  }

  .faq__item {
    border-bottom: 1px solid var(--bone-300);
  }

  /* ---- Question ---- */
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 26px 0;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: clamp(18px, 0.3797vw + 0.9707rem, 21px);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: var(--tracking-tight);
    color: var(--navy-700);
    /* Suppress the native disclosure triangle in every engine. */
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--gold-500) 55%, transparent);
    outline-offset: 4px;
    border-radius: var(--radius-xs);
  }

  .faq__marker {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    color: var(--gold-500);
  }

  .faq__marker svg {
    width: 20px;
    height: 20px;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .faq__item[open] .faq__marker svg {
    transform: rotate(45deg);
  }

  /* ---- Answer ---- */
  /* ::details-content is the browser's own wrapper around everything after
     the <summary>, which is what makes a native <details> animatable without
     JS. content-visibility needs allow-discrete so the closed state waits for
     the height to finish collapsing instead of snapping away at frame one.
     Engines without ::details-content just open and close instantly. */
  .faq__item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size var(--dur-slow) var(--ease-out),
      content-visibility var(--dur-slow) var(--ease-out) allow-discrete;
  }

  .faq__item[open]::details-content {
    block-size: auto;
  }

  .faq__a {
    padding-bottom: 28px;
  }

  .faq__a p {
    max-width: 960px;
    margin: 0;
    color: var(--ink-500);
  }

  /* ---- Ask card ---- */
  .faq__ask {
    display: flex;
    align-items: center;
    gap: 20px;
    max-width: 1000px;
    margin: 40px auto 0;
    padding: 22px 28px;
    border: 1px solid var(--bone-300);
    border-radius: var(--radius-md);
  }

  .faq__ask-avatar {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--gold-500);
  }

  .faq__ask-copy {
    min-width: 0;
  }

  .faq__ask-title {
    margin-bottom: 2px;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--navy-700);
  }

  .faq__ask-text {
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-500);
  }

  .faq__ask-cta {
    flex: none;
    margin-left: auto;
    padding: 12px 30px;
  }

  /* Tablet */
  @media (max-width: 1000px) {
    .faq__head {
      margin-bottom: 40px;
    }
  }

  /* Mobile */
  @media (max-width: 650px) {
    .faq--flush {
      padding-block-start: 4px;
    }

    .faq__eyebrow {
      font-size: 13px;
      letter-spacing: 0.14em;
    }

    .faq__q {
      gap: 18px;
      padding: 20px 0;
    }

    .faq__a {
      padding-bottom: 22px;
    }

    .faq__a p {
      font-size: 16px;
      line-height: 27px;
    }

    /* Stack: avatar and copy on one row, the CTA full width beneath. */
    .faq__ask {
      flex-wrap: wrap;
      gap: 16px;
      padding: 22px 20px;
    }

    .faq__ask-cta {
      width: 100%;
      margin-left: 0;
    }
  }

  /* The global reduced-motion rule covers *, ::before and ::after, but not
     ::details-content, so it needs stopping here. */
  @media (prefers-reduced-motion: reduce) {
    .faq__item::details-content {
      transition: none;
    }
  }
</style>
