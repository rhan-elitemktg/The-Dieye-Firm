---
// Testimonials — "Success Stories". A scroll-snap carousel of review cards:
// three per view on desktop, two on tablet, one on mobile.

import { Image } from "astro:assets";
import birdGold from "../../assets/images/logo-bird-gold.png";

/* THE HOMEPAGE'S SIX, SELECTED FROM THE REAL FOURTEEN.

   This band used to hold six INVENTED reviews attributed to invented people
   (Danielle, Marcus, Renee, Anthony, Simone, Curtis), carrying its own "replace
   before launch" note. They rendered on / and /about-us/, the two
   highest-traffic pages, while the firm's 14 real published reviews sat unused
   in the testimonials component. A law firm attributing a fabricated quote to a
   named client is a Texas Bar advertising problem before it is a content
   problem. The rule that replaced them now lives on the schema type
   (src/sanity/schemaTypes/testimonial.ts), where an editor can see it.

   WHICH SIX IS NOW AN EDITOR'S CHOICE, made on the Home Page document under
   Pages -> Home Page -> Success Stories. It used to be a `pick(name, matter)`
   lookup here that threw on a miss. The reasoning behind the current six is
   recorded on that field's description and in scripts/import/home-page.ts;
   the short version, in priority order:

     1. The pull quote must not repeat inside the body. Six of the fourteen quote
        their own pull quote back in the body text - the wall on /testimonials/
        tolerates that, because the sentence is only dropped where it STANDS
        ALONE and in those six it is embedded mid-sentence where cutting it
        would mangle the client's grammar. On a masonry wall it passes; on three
        side-by-side cards, reading the same sentence at 30px and again at 17px
        is the first thing the eye catches. Eight qualify.
     2. A spread of matters.
     3. Bodies that fill a card without dwarfing their neighbours - the corpus
        runs from 11 to 127 words and the row takes its height from the tallest.

   Kim is deliberately excluded: home/About.astro quotes her, and both sections
   render on the homepage, so picking her would print the same review twice on
   one page. The Home Page document enforces that - the import refuses to write
   a pull quote that is also in this band.

   There is no Child Support review because no real review names child support.
   The matter is simply absent rather than filled with something that doesn't
   say it. */
import { getHomeTestimonials } from "../../sanity/testimonials";
import { getHomePage } from "../../sanity/homePage";

const copy = (await getHomePage()).testimonials;

/* Which six, and their order, is set on the Home Page document
   (Pages -> Home Page -> Success Stories) rather than chosen here. It used to be
   a `pick(name, matter)` lookup into a compiled-in array that threw on a miss;
   the references replace both the lookup and the throw, and an editor renaming a
   client can no longer fail the build. */
const { picks: testimonials } = await getHomeTestimonials();
---

<section class="tst section" aria-labelledby="tst-title" data-tst>
  <div class="container">
    <header class="tst__head">
      <p class="tst__eyebrow">
        <Image src={birdGold} alt="" width={70} format="webp" loading="lazy" decoding="async" />
        <span>{copy.eyebrow}</span>
      </p>
      <h2 class="tst__title" id="tst-title">{copy.headingLead}{" "}{copy.headingAccent && <em>{copy.headingAccent}</em>}</h2>
      <p class="tst__lead">{copy.lead}</p>
      <a class="btn btn--gold tst__cta" href="/testimonials/">{copy.ctaLabel}</a>
    </header>

    <ul class="tst__track" tabindex="0" role="region" aria-label="Client testimonials" data-tst-track>
      {testimonials.map((item) => (
        <li class="tst__slide">
          <figure class="tcard">
            <p class="tcard__kicker">{copy.cardKicker}</p>

            <div class="tcard__stars" role="img" aria-label="Five out of five stars">
              {[...Array(5)].map(() => (
                <span class="tcard__star">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                </span>
              ))}
            </div>

            <blockquote class="tcard__lead">{item.lead}</blockquote>
            <p class="tcard__body">{item.body}</p>

            <figcaption class="tcard__cite">
              <span class="tcard__name">{item.name}</span>
              <span class="tcard__matter">{item.matter}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <div class="tst__nav">
      <button class="tst__arrow" type="button" aria-label="Previous testimonials" data-tst-prev>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="tst__arrow" type="button" aria-label="Next testimonials" data-tst-next>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .tst {
    --tst-gap: 30px;
    background: var(--bone-100);
  }

  /* ---- Head ---- */
  .tst__head {
    max-width: 760px;
    margin: 0 auto 54px;
    text-align: center;
  }

  .tst__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy-700);
  }

  .tst__eyebrow img {
    width: 30px;
    height: auto;
    flex: none;
  }

  .tst__title {
    margin-bottom: 18px;
    font-size: clamp(34px, 2.2785vw + 1.1994rem, 52px);
    line-height: 1.12;
  }

  .tst__title em {
    font-style: italic;
    color: var(--gold-600);
  }

  .tst__lead {
    margin-bottom: 32px;
    color: var(--ink-500);
  }

  .tst__cta {
    min-width: 260px;
    padding: 12px 34px;
  }

  /* ---- Track ---- */
  /* Same scroll-snap carousel as the awards strip: the slides are real
     scroll children, so keyboard and touch paging come for free and the
     arrows only nudge scrollLeft. */
  .tst__track {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: var(--tst-gap);
    list-style: none;
    margin: 0;
    /* The scrollport clips on every side, so the padding gives the cards'
       drop shadows somewhere to land. Inner cards get the gap to bleed into,
       but the first and last would otherwise be sliced flat at the track's
       edges. The negative margin cancels the inline padding so the cards
       still line up with the rest of the page's container, and
       scroll-padding moves the snapport in to match — without it the first
       card can't rest at scrollLeft 0 and the track jumps on load. */
    padding: 12px 16px 28px;
    margin-inline: -16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .tst__track::-webkit-scrollbar {
    display: none;
  }

  .tst__track:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--gold-500) 55%, transparent);
    outline-offset: 6px;
    border-radius: var(--radius-sm);
  }

  .tst__slide {
    flex: 0 0 calc((100% - 2 * var(--tst-gap)) / 3);
    display: flex;
    scroll-snap-align: start;
  }

  /* ---- Card ---- */
  .tcard {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
    padding: 48px 40px 42px;
    background: var(--white);
    border-radius: var(--radius-lg);
    /* Lighter than --shadow-md: the cards sit on bone rather than white, so
       the token's weight reads heavier here than it does elsewhere. */
    box-shadow: 0 10px 24px -14px rgba(21, 33, 46, 0.22);
    text-align: center;
  }

  /* The inset frame from the mockup. Set well in from the edge, so the
     corner radius is nominal rather than concentric with the card's. */
  .tcard::before {
    content: "";
    position: absolute;
    inset: 16px;
    border: 1px solid color-mix(in srgb, var(--gold-500) 30%, transparent);
    border-radius: var(--radius-sm);
    pointer-events: none;
  }

  .tcard__kicker {
    margin-bottom: 18px;
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--navy-700);
  }

  /* ---- Stars ---- */
  .tcard__stars {
    display: flex;
    justify-content: center;
    gap: 7px;
    margin-bottom: 26px;
  }

  .tcard__star {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1.5px solid var(--gold-500);
    border-radius: var(--radius-pill);
    color: var(--gold-500);
  }

  .tcard__star svg {
    width: 13px;
    height: 13px;
  }

  /* ---- Copy ---- */
  /* Four lines reserved, for the same reason as the selling-point titles:
     one of these leads re-wraps from four lines to three when Source Serif 4
     swaps in, and since the slides stretch to the tallest card that pulled
     the whole track's height with it. */
  .tcard__lead {
    min-height: 5.28em;
    margin: 0 0 18px;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: var(--tracking-tight);
    color: var(--navy-700);
  }

  /* Clamped rather than truncated in the data, so the full review stays in
     the markup for search engines and assistive tech. */
  .tcard__body {
    margin-bottom: 30px;
    font-size: 16px;
    line-height: 27px;
    color: var(--ink-500);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
  }

  /* ---- Attribution ---- */
  /* margin-top:auto pins it to the card's bottom, so the rules and names
     line up across a row of cards whose quotes run to different lengths. */
  .tcard__cite {
    margin-top: auto;
  }

  .tcard__cite::before {
    content: "";
    display: block;
    width: 40px;
    height: var(--rule-width);
    margin: 0 auto 16px;
    background: var(--gold-500);
  }

  .tcard__name {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--navy-700);
  }

  .tcard__matter {
    display: block;
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.2;
    color: var(--ink-500);
  }

  /* ---- Arrows ---- */
  /* Pulled in to offset the track's new bottom padding, so the gap between
     the cards and the arrows reads the same as before. */
  .tst__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 16px;
  }

  .tst__arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--navy-900);
    color: var(--white);
    transition:
      background var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .tst__arrow:hover:not(:disabled) {
    background: var(--gold-500);
    transform: translateY(var(--hover-lift));
  }

  .tst__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .tst__arrow svg {
    width: 20px;
    height: 20px;
  }

  /* Small Desktop */
  @media (max-width: 1439px) {
    .tst {
      --tst-gap: 24px;
    }

    .tcard {
      padding: 40px 32px 36px;
    }
  }

  /* Tablet — two per view. */
  @media (max-width: 1000px) {
    .tst__head {
      margin-bottom: 40px;
    }

    .tst__slide {
      flex: 0 0 calc((100% - var(--tst-gap)) / 2);
    }
  }

  /* Mobile — one per view. */
  @media (max-width: 650px) {
    .tst {
      --tst-gap: 16px;
    }

    .tst__eyebrow {
      font-size: 13px;
      letter-spacing: 0.14em;
    }

    .tst__cta {
      width: 100%;
    }

    .tst__slide {
      flex: 0 0 100%;
    }

    .tcard {
      padding: 34px 26px 30px;
    }

    .tcard::before {
      inset: 12px;
    }

    .tst__nav {
      margin-top: 10px;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-tst]");
  const track = section?.querySelector<HTMLElement>("[data-tst-track]");
  const prev = section?.querySelector<HTMLButtonElement>("[data-tst-prev]");
  const next = section?.querySelector<HTMLButtonElement>("[data-tst-next]");

  if (section && track && prev && next) {
    /* Derive the page width from the slides themselves rather than
       hard-coding per-breakpoint counts, so it stays correct if the sizing
       changes. */
    const pageWidth = () => {
      const first = track.firstElementChild as HTMLElement | null;
      if (!first) return track.clientWidth;
      const styles = getComputedStyle(track);
      const gap = parseFloat(styles.columnGap) || 0;
      // clientWidth includes the track's inline padding, which exists only to
      // catch the cards' shadows. Measure against the content box so the
      // per-view count doesn't drift.
      const viewport =
        track.clientWidth -
        (parseFloat(styles.paddingLeft) || 0) -
        (parseFloat(styles.paddingRight) || 0);
      const stride = first.getBoundingClientRect().width + gap;
      const perView = stride > 0 ? Math.max(1, Math.round((viewport + gap) / stride)) : 1;
      return perView * stride;
    };

    const sync = () => {
      // 1px of slack absorbs sub-pixel rounding in the scroll metrics.
      const atStart = track.scrollLeft <= 1;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
      const scrollable = track.scrollWidth > track.clientWidth + 1;
      prev.disabled = atStart || !scrollable;
      next.disabled = atEnd || !scrollable;
      section.classList.toggle("is-scrollable", scrollable);
    };

    const page = (direction: number) =>
      track.scrollBy({ left: direction * pageWidth(), behavior: "smooth" });

    prev.addEventListener("click", () => page(-1));
    next.addEventListener("click", () => page(1));
    track.addEventListener("scroll", sync, { passive: true });
    new ResizeObserver(sync).observe(track);

    sync();
  }
</script>
