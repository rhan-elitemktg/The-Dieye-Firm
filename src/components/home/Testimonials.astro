---
// Testimonials — "Success Stories". A scroll-snap carousel of review cards:
// three per view on desktop, two on tablet, one on mobile.

import { Image } from "astro:assets";
import birdGold from "../../assets/images/logo-bird-gold.png";

/* PLACEHOLDER COPY — replace with real, attributable client reviews before
   launch (see the note in the component's README/handoff). */
const testimonials = [
  {
    lead: "From our very first conversation, Papa made me feel like a person, not a case number.",
    body: "He took the time to really understand what mattered most to me and my children, explained every option in plain language, and never once made me feel rushed or judged. When things got difficult he stayed calm and steady, and he was always honest with me, even when the answer wasn't the one I wanted to hear.",
    name: "Danielle",
    matter: "Child Custody",
  },
  {
    lead: "I walked in completely overwhelmed and, honestly, a little afraid of what was ahead of me.",
    body: "Papa guided me through the whole process one step at a time and answered every question I had, no matter how small it seemed. He was patient, respectful, and upfront about what to expect without ever overpromising me anything. Having someone this experienced and this steady in my corner changed everything.",
    name: "Marcus",
    matter: "Divorce",
  },
  {
    lead: "After speaking with a few other firms, the difference at The Dieye Firm was immediate.",
    body: "Papa listened carefully before he advised, remembered the small details about my family, and made a complicated, stressful situation feel genuinely manageable. He was fair, transparent about every fee, and worked hard to keep things as calm and respectful as possible throughout the entire matter.",
    name: "Renee",
    matter: "Family Law",
  },
  {
    lead: "He never once made me feel like my case was too small to matter.",
    body: "I came in worried that a modification wasn't worth anyone's time, and Papa treated it with the same care he would have given anything else. He explained exactly what the court would look for, prepared me properly, and kept me updated at every stage without me ever having to chase him for an answer.",
    name: "Anthony",
    matter: "Modifications",
  },
  {
    lead: "What I remember most is how much calmer I felt walking out of that first meeting.",
    body: "Papa was direct about the parts that would be hard and just as direct about what we could realistically achieve. That honesty made it possible for me to make good decisions instead of fearful ones, and it is the reason I have recommended him to two friends since.",
    name: "Simone",
    matter: "Property Division",
  },
  {
    lead: "Seventeen years of experience shows the moment he starts talking about your case.",
    body: "He anticipated issues I would never have thought of and had a plan for each of them. Through it all he stayed patient with me and my family, returned every call, and made sure I understood what was happening and why before anything was filed.",
    name: "Curtis",
    matter: "Child Support",
  },
];
---

<section class="tst section" aria-labelledby="tst-title" data-tst>
  <div class="container">
    <header class="tst__head">
      <p class="tst__eyebrow">
        <Image src={birdGold} alt="" width={70} format="webp" loading="lazy" decoding="async" />
        <span>In Their Words</span>
      </p>
      <h2 class="tst__title" id="tst-title">Success <em>Stories</em></h2>
      <p class="tst__lead">
        Real outcomes for real families, shared with care, never as a guarantee.
      </p>
      <a class="btn btn--gold tst__cta" href="/testimonials/">View All Reviews</a>
    </header>

    <ul class="tst__track" tabindex="0" role="region" aria-label="Client testimonials" data-tst-track>
      {testimonials.map((item) => (
        <li class="tst__slide">
          <figure class="tcard">
            <p class="tcard__kicker">Testimonial</p>

            <div class="tcard__stars" role="img" aria-label="Five out of five stars">
              {[...Array(5)].map(() => (
                <span class="tcard__star">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                </span>
              ))}
            </div>

            <blockquote class="tcard__lead">{item.lead}</blockquote>
            <p class="tcard__body">{item.body}</p>

            <figcaption class="tcard__cite">
              <span class="tcard__name">{item.name}</span>
              <span class="tcard__matter">{item.matter}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <div class="tst__nav">
      <button class="tst__arrow" type="button" aria-label="Previous testimonials" data-tst-prev>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="tst__arrow" type="button" aria-label="Next testimonials" data-tst-next>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .tst {
    --tst-gap: 30px;
    background: var(--bone-100);
  }

  /* ---- Head ---- */
  .tst__head {
    max-width: 760px;
    margin: 0 auto 54px;
    text-align: center;
  }

  .tst__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy-700);
  }

  .tst__eyebrow img {
    width: 30px;
    height: auto;
    flex: none;
  }

  .tst__title {
    margin-bottom: 18px;
    font-size: clamp(34px, 2.2785vw + 1.1994rem, 52px);
    line-height: 1.12;
  }

  .tst__title em {
    font-style: italic;
    color: var(--gold-600);
  }

  .tst__lead {
    margin-bottom: 32px;
    color: var(--ink-500);
  }

  .tst__cta {
    min-width: 260px;
    padding: 18px 34px;
  }

  /* ---- Track ---- */
  /* Same scroll-snap carousel as the awards strip: the slides are real
     scroll children, so keyboard and touch paging come for free and the
     arrows only nudge scrollLeft. */
  .tst__track {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: var(--tst-gap);
    list-style: none;
    margin: 0;
    /* The scrollport clips on every side, so the padding gives the cards'
       drop shadows somewhere to land. Inner cards get the gap to bleed into,
       but the first and last would otherwise be sliced flat at the track's
       edges. The negative margin cancels the inline padding so the cards
       still line up with the rest of the page's container, and
       scroll-padding moves the snapport in to match — without it the first
       card can't rest at scrollLeft 0 and the track jumps on load. */
    padding: 12px 16px 28px;
    margin-inline: -16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .tst__track::-webkit-scrollbar {
    display: none;
  }

  .tst__track:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--gold-500) 55%, transparent);
    outline-offset: 6px;
    border-radius: var(--radius-sm);
  }

  .tst__slide {
    flex: 0 0 calc((100% - 2 * var(--tst-gap)) / 3);
    display: flex;
    scroll-snap-align: start;
  }

  /* ---- Card ---- */
  .tcard {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
    padding: 48px 40px 42px;
    background: var(--white);
    border-radius: var(--radius-lg);
    /* Lighter than --shadow-md: the cards sit on bone rather than white, so
       the token's weight reads heavier here than it does elsewhere. */
    box-shadow: 0 10px 24px -14px rgba(21, 33, 46, 0.22);
    text-align: center;
  }

  /* The inset frame from the mockup. Set well in from the edge, so the
     corner radius is nominal rather than concentric with the card's. */
  .tcard::before {
    content: "";
    position: absolute;
    inset: 16px;
    border: 1px solid color-mix(in srgb, var(--gold-500) 30%, transparent);
    border-radius: var(--radius-sm);
    pointer-events: none;
  }

  .tcard__kicker {
    margin-bottom: 18px;
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--navy-700);
  }

  /* ---- Stars ---- */
  .tcard__stars {
    display: flex;
    justify-content: center;
    gap: 7px;
    margin-bottom: 26px;
  }

  .tcard__star {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1.5px solid var(--gold-500);
    border-radius: var(--radius-pill);
    color: var(--gold-500);
  }

  .tcard__star svg {
    width: 13px;
    height: 13px;
  }

  /* ---- Copy ---- */
  /* Four lines reserved, for the same reason as the selling-point titles:
     one of these leads re-wraps from four lines to three when Source Serif 4
     swaps in, and since the slides stretch to the tallest card that pulled
     the whole track's height with it. */
  .tcard__lead {
    min-height: 5.28em;
    margin: 0 0 18px;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: var(--tracking-tight);
    color: var(--navy-700);
  }

  /* Clamped rather than truncated in the data, so the full review stays in
     the markup for search engines and assistive tech. */
  .tcard__body {
    margin-bottom: 30px;
    font-size: 16px;
    line-height: 27px;
    color: var(--ink-500);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
  }

  /* ---- Attribution ---- */
  /* margin-top:auto pins it to the card's bottom, so the rules and names
     line up across a row of cards whose quotes run to different lengths. */
  .tcard__cite {
    margin-top: auto;
  }

  .tcard__cite::before {
    content: "";
    display: block;
    width: 40px;
    height: var(--rule-width);
    margin: 0 auto 16px;
    background: var(--gold-500);
  }

  .tcard__name {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--navy-700);
  }

  .tcard__matter {
    display: block;
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.2;
    color: var(--ink-500);
  }

  /* ---- Arrows ---- */
  /* Pulled in to offset the track's new bottom padding, so the gap between
     the cards and the arrows reads the same as before. */
  .tst__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 16px;
  }

  .tst__arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--navy-900);
    color: var(--white);
    transition:
      background var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .tst__arrow:hover:not(:disabled) {
    background: var(--gold-500);
    transform: translateY(var(--hover-lift));
  }

  .tst__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .tst__arrow svg {
    width: 20px;
    height: 20px;
  }

  /* Small Desktop */
  @media (max-width: 1439px) {
    .tst {
      --tst-gap: 24px;
    }

    .tcard {
      padding: 40px 32px 36px;
    }
  }

  /* Tablet — two per view. */
  @media (max-width: 1000px) {
    .tst__head {
      margin-bottom: 40px;
    }

    .tst__slide {
      flex: 0 0 calc((100% - var(--tst-gap)) / 2);
    }
  }

  /* Mobile — one per view. */
  @media (max-width: 650px) {
    .tst {
      --tst-gap: 16px;
    }

    .tst__eyebrow {
      font-size: 13px;
      letter-spacing: 0.14em;
    }

    .tst__cta {
      width: 100%;
    }

    .tst__slide {
      flex: 0 0 100%;
    }

    .tcard {
      padding: 34px 26px 30px;
    }

    .tcard::before {
      inset: 12px;
    }

    .tst__nav {
      margin-top: 10px;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-tst]");
  const track = section?.querySelector<HTMLElement>("[data-tst-track]");
  const prev = section?.querySelector<HTMLButtonElement>("[data-tst-prev]");
  const next = section?.querySelector<HTMLButtonElement>("[data-tst-next]");

  if (section && track && prev && next) {
    /* Derive the page width from the slides themselves rather than
       hard-coding per-breakpoint counts, so it stays correct if the sizing
       changes. */
    const pageWidth = () => {
      const first = track.firstElementChild as HTMLElement | null;
      if (!first) return track.clientWidth;
      const styles = getComputedStyle(track);
      const gap = parseFloat(styles.columnGap) || 0;
      // clientWidth includes the track's inline padding, which exists only to
      // catch the cards' shadows. Measure against the content box so the
      // per-view count doesn't drift.
      const viewport =
        track.clientWidth -
        (parseFloat(styles.paddingLeft) || 0) -
        (parseFloat(styles.paddingRight) || 0);
      const stride = first.getBoundingClientRect().width + gap;
      const perView = stride > 0 ? Math.max(1, Math.round((viewport + gap) / stride)) : 1;
      return perView * stride;
    };

    const sync = () => {
      // 1px of slack absorbs sub-pixel rounding in the scroll metrics.
      const atStart = track.scrollLeft <= 1;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
      const scrollable = track.scrollWidth > track.clientWidth + 1;
      prev.disabled = atStart || !scrollable;
      next.disabled = atEnd || !scrollable;
      section.classList.toggle("is-scrollable", scrollable);
    };

    const page = (direction: number) =>
      track.scrollBy({ left: direction * pageWidth(), behavior: "smooth" });

    prev.addEventListener("click", () => page(-1));
    next.addEventListener("click", () => page(1));
    track.addEventListener("scroll", sync, { passive: true });
    new ResizeObserver(sync).observe(track);

    sync();
  }
</script>
