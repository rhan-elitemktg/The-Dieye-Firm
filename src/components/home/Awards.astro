---
// Awards — trust strip of accreditation badges beneath the hero.
// Presented as a scroll-snap carousel: 1 badge per view on mobile, 3 on
// tablet, and natural widths on desktop. On desktop the carousel only
// engages when the badges actually overflow the container (i.e. once there
// are more than the seven that currently fit), so it stays a static centred
// row until it needs to be anything else.

import { Image } from "astro:assets";
import avPreeminent from "../../assets/images/awards/av-preeminent.png";
import avvoSuperb from "../../assets/images/awards/avvo-superb.png";
import nationalTop100 from "../../assets/images/awards/national-top-100-black-lawyers.png";
import avvoTopAttorney from "../../assets/images/awards/avvo-top-attorney.png";
import avvoReviews from "../../assets/images/awards/avvo-reviews.png";
import avvoClientsChoice from "../../assets/images/awards/avvo-clients-choice.png";
import texasBarCollege from "../../assets/images/awards/texas-bar-college.png";

/* `width` caps the generated file at roughly 2x the largest rendered size
   (190px), which mainly matters for the Texas Bar lockup — its source is
   1024px wide for a badge that never renders above 190. The rest are already
   at or under the cap, so they're only re-encoded, never upscaled. */
const awards = [
  {
    src: avPreeminent,
    width: 256,
    alt: "Martindale-Hubbell AV Preeminent, peer rated for the highest level of professional excellence",
  },
  { src: avvoSuperb, width: 155, alt: "Avvo Rating 10.0 Superb, Top Lawyer" },
  { src: nationalTop100, width: 175, alt: "The National Top 100 Black Lawyers" },
  {
    src: avvoTopAttorney,
    width: 263,
    alt: "Avvo Rating 10.0, Papa Magaye Dieye, Top Attorney",
  },
  {
    src: avvoReviews,
    width: 242,
    alt: "Avvo Reviews, 4.5 stars out of 17 reviews for Papa Magaye Dieye",
  },
  {
    src: avvoClientsChoice,
    width: 313,
    alt: "Avvo Clients' Choice Award 2016, Papa Magaye Dieye",
  },
  { src: texasBarCollege, width: 380, alt: "Proud member of the Texas Bar College" },
];
---

<section class="awards" aria-labelledby="awards-title" data-awards>
  <div class="container">
    <h2 class="awards__title" id="awards-title">Awards &amp; Recognition</h2>

    <div class="awards__viewport">
      <ul
        class="awards__track"
        tabindex="0"
        role="region"
        aria-label="Awards and recognition"
        data-awards-track
      >
        {awards.map((award) => (
          <li class="awards__item">
            <Image
              src={award.src}
              alt={award.alt}
              width={award.width}
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </div>

    {/* One dot per badge is rendered up front (the most pages there can ever
        be, at one-per-view), and the script hides the surplus once it knows
        how many fit per view. Rendering them here rather than creating them
        in JS keeps them inside Astro's scoped styles. */}
    <div class="awards__dots" data-awards-dots>
      {awards.map((_, i) => (
        <button
          class="awards__dot"
          type="button"
          aria-label={`Show awards, page ${i + 1}`}
          hidden
        />
      ))}
    </div>
  </div>
</section>

<style>
  /* A compact trust strip rather than a full section, so it uses its own
     tighter rhythm instead of the 130px --section-pad-y. */
  .awards {
    --awards-gap: 44px;
    padding-block: 56px;
    background: var(--white);
    border-bottom: 1px solid var(--bone-300);
  }

  .awards__title {
    margin-bottom: 34px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
    color: var(--gold-600);
  }

  /* Positioning context for the prev/next arrows. */
  .awards__viewport {
    position: relative;
  }

  /* `safe center` keeps the row centred while it fits, but falls back to
     start-aligned once it overflows — without it the first badge becomes
     unreachable in a centred scroll container. */
  .awards__track {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: safe center;
    gap: var(--awards-gap);
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .awards__track::-webkit-scrollbar {
    display: none;
  }

  .awards__track:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--gold-500) 55%, transparent);
    outline-offset: 6px;
    border-radius: var(--radius-sm);
  }

  /* Snap to the item's leading edge, not its centre. Paging advances one
     full viewport (3 badges on tablet, 1 on mobile), which lands exactly on
     an item boundary — centre-snapping fights that and springs back. */
  .awards__item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    scroll-snap-align: start;
  }

  /* The badges have wildly different aspect ratios (3.4:1 through 1:1), so
     they're capped on both axes to keep the wide lockups from dwarfing the
     circular seals. Height is definite (not auto) so the browser can derive
     the width from the width/height attributes before the file loads — with
     both axes auto the box collapses to 0x0, which also stops lazy loading
     from ever triggering. */
  .awards__item img {
    height: 88px;
    width: auto;
    max-width: 190px;
    object-fit: contain;
  }

  /* Dots — only revealed when the track actually overflows. */
  .awards__dots {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin-top: 26px;
  }

  .awards.is-scrollable .awards__dots {
    display: flex;
  }

  /* The button is a 24px tap target; the visible dot is the ::before. */
  .awards__dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    background: transparent;
    border: 0;
  }

  /* display:grid would otherwise defeat the hidden attribute. */
  .awards__dot[hidden] {
    display: none;
  }

  .awards__dot::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--bone-400);
    transition:
      background var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .awards__dot:hover::before {
    background: var(--gold-300);
  }

  .awards__dot[aria-current="true"]::before {
    background: var(--gold-500);
    transform: scale(1.3);
  }

  /* Small Desktop — step the badges down so all seven still hold one row
     once the 100px gutter drops away. */
  @media (max-width: 1439px) {
    .awards {
      --awards-gap: 40px;
    }

    .awards__item img {
      height: 76px;
      max-width: 165px;
    }
  }

  /* Tablet — three badges per view. */
  @media (max-width: 1000px) {
    .awards {
      --awards-gap: 32px;
    }

    .awards__item {
      flex: 0 0 calc((100% - 2 * var(--awards-gap)) / 3);
    }

    .awards__item img {
      height: 64px;
      max-width: 100%;
    }
  }

  /* Mobile — one badge per view. */
  @media (max-width: 650px) {
    .awards {
      --awards-gap: 24px;
      padding-block: 44px;
    }

    .awards__title {
      margin-bottom: 26px;
      font-size: 13px;
      letter-spacing: 0.16em;
    }

    .awards__item {
      flex: 0 0 100%;
    }

    .awards__item img {
      height: 72px;
      max-width: 100%;
    }

    .awards__nav--prev {
      left: -10px;
    }

    .awards__nav--next {
      right: -10px;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-awards]");
  const track = section?.querySelector<HTMLElement>("[data-awards-track]");
  const dots = section?.querySelector<HTMLElement>("[data-awards-dots]");

  if (section && track && dots) {
    /* Derive how many badges are on screen from their actual width rather
       than hard-coding per-breakpoint counts, so the dot count stays correct
       if the sizing changes. */
    const metrics = () => {
      const items = Array.from(track.children) as HTMLElement[];
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const stride = (items[0]?.getBoundingClientRect().width ?? 0) + gap;
      const perView =
        stride > 0 ? Math.max(1, Math.round((track.clientWidth + gap) / stride)) : 1;
      return { perView, pageWidth: perView * stride, pages: Math.ceil(items.length / perView) };
    };

    const syncActive = () => {
      const { pageWidth, pages } = metrics();
      // The final page clamps flush-right rather than scrolling a full page
      // width, so rounding alone would leave the last dot unreachable.
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
      const active = atEnd
        ? pages - 1
        : pageWidth > 0
          ? Math.min(pages - 1, Math.round(track.scrollLeft / pageWidth))
          : 0;
      Array.from(dots.children).forEach((dot, i) =>
        dot.setAttribute("aria-current", i === active ? "true" : "false"),
      );
    };

    const dotEls = Array.from(dots.querySelectorAll<HTMLButtonElement>(".awards__dot"));

    dotEls.forEach((dot, i) =>
      dot.addEventListener("click", () =>
        track.scrollTo({ left: i * metrics().pageWidth, behavior: "smooth" }),
      ),
    );

    const render = () => {
      // 1px of slack absorbs sub-pixel rounding in the scroll metrics.
      const scrollable = track.scrollWidth > track.clientWidth + 1;
      section.classList.toggle("is-scrollable", scrollable);

      const pages = scrollable ? metrics().pages : 0;
      dotEls.forEach((dot, i) => (dot.hidden = i >= pages));

      if (scrollable) syncActive();
    };

    track.addEventListener("scroll", syncActive, { passive: true });
    new ResizeObserver(render).observe(track);

    render();
  }
</script>
