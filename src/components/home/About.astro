---
// About — sidebar + content section. Built on the project's 3-column grid:
// the media/testimonial aside takes 1 column, the copy spans 2.

import { Image } from "astro:assets";
import birdGold from "../../assets/images/logo-bird-gold.png";
import videoPoster from "../../assets/images/video-poster-pearland.jpg";
import headshot from "../../assets/images/papa-headshot.jpg";
import { getAboutPullQuote } from "../../sanity/testimonials";
import { getAttorney } from "../../sanity/siteWide";
import { getHomePage } from "../../sanity/homePage";

/* The pull-quote in the aside. It used to be an INVENTED review attributed to
   "Danielle R. / Divorce & Custody" - hand-written markup, carrying no
   placeholder note of any kind, which is why it outlived the six invented ones
   in home/Testimonials.astro. It is now a real published review, read from the
   one source the whole site quotes clients from.

   Kim's is the shortest of the fourteen that still reads as a complete thought,
   which is what this slot needs: the aside is one column beside two of copy, so
   a 50-word quote pushes the video tile off the fold. */
const quote = await getAboutPullQuote();

/* His title comes from the attorney record rather than from this caption. Five
   components render it - the article byline plus four marketing spots - and each
   used to hold its own copy of the string, which is how the byline came to say
   "Principal & Founder" while these sections said "Founding Attorney". */
const attorney = await getAttorney();

const WISTIA_ID = "xnom95l12h";

/* Wistia metadata is pulled at build time. It's wrapped so a Wistia outage
   can never fail the build — the aria-label just falls back to a plain
   label if the request doesn't come back. */
const mediaUrl = "https://home.wistia.com/medias/" + WISTIA_ID;
const oembedUrl = "https://fast.wistia.com/oembed?url=" + encodeURIComponent(mediaUrl);

let duration: number | null = null;
try {
  const response = await fetch(oembedUrl);
  if (response.ok) {
    const data = await response.json();
    duration = typeof data.duration === "number" ? data.duration : null;
  }
} catch (error) {
  duration = null;
}

const runtime = duration
  ? `${Math.floor(duration / 60)}:${String(Math.round(duration % 60)).padStart(2, "0")}`
  : null;

const playLabel = runtime
  ? `Play video: Meet Papa Dieye (${runtime})`
  : "Play video: Meet Papa Dieye";

/* The poster is the designed still from the mockup. Wistia's auto-generated
   thumbnail is a mid-sentence frame, so it isn't used — swap this for the
   oEmbed `thumbnail_url` if a proper thumbnail is set in Wistia. */

const copy = (await getHomePage()).about;
---

<section class="about section" aria-labelledby="about-title">
  <div class="container">
    <header class="about__head">
      <p class="about__eyebrow">
        <Image src={birdGold} alt="" width={70} format="webp" loading="lazy" decoding="async" />
        <span>{copy.eyebrow}</span>
      </p>
      <h2 class="about__title" id="about-title">{copy.headingLead}{" "}{copy.headingAccent && <em>{copy.headingAccent}</em>}</h2>
    </header>

    <div class="about__grid">
      <aside class="about__aside">
        <button
          class="video-card"
          type="button"
          aria-label={playLabel}
          data-video-open
          data-wistia-id={WISTIA_ID}
          data-video-title="Meet Papa Dieye"
        >
          <Image
            class="video-card__poster"
            src={videoPoster}
            alt=""
            widths={[480, 720, 960]}
            sizes="(max-width: 1000px) 100vw, 360px"
            format="webp"
            quality={80}
            loading="lazy"
            decoding="async"
          />
          <span class="video-card__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
          </span>
          <span class="video-card__meta">
            <span class="video-card__label">{copy.videoLabel}</span>
            <span class="video-card__caption">{copy.videoCaption}</span>
          </span>
        </button>

        <figure class="testimonial">
          <div class="testimonial__stars" role="img" aria-label="Five out of five stars">
            {[...Array(5)].map(() => (
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
            ))}
          </div>
          <blockquote class="testimonial__quote">&ldquo;{quote.lead}&rdquo;</blockquote>
          <figcaption class="testimonial__cite">
            <span class="testimonial__name">{quote.name}</span>
            <span class="testimonial__case">{quote.matter}</span>
          </figcaption>
        </figure>
      </aside>

      <div class="about__body">
        <p class="about__lead">{copy.lead}</p>

        <p>{copy.intro}</p>

        <h3>{copy.helpHeading}</h3>
        <p>{copy.helpIntro}</p>

        <ul class="checklist">
          {copy.checklist.map((item) => (
            <li>
              <span class="checklist__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path
                    d="M5 12.5l4.5 4.5L19 7.5"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span><strong>{item.lead}</strong> {item.text}</span>
            </li>
          ))}
        </ul>

        <figure class="pullquote">
          <blockquote>
            "I tell every client the same thing on day one: my job is to protect your
            family, and to make sure you never feel alone in this process."
          </blockquote>
          <figcaption>
            <Image
              src={headshot}
              alt=""
              width={104}
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
            />
            <span>
              <span class="pullquote__name">{attorney.name}</span>
              <span class="pullquote__role">{attorney.role}</span>
            </span>
          </figcaption>
        </figure>

        <h3>{copy.whyHeading}</h3>
        {copy.whyParagraphs.map((text) => <p>{text}</p>)}

        <h3>{copy.servingHeading}</h3>
        <p>{copy.servingParagraph}</p>

        <a class="btn btn--gold about__cta" href="/contact-us/">{copy.ctaLabel}</a>
      </div>
    </div>
  </div>
</section>

{/* The video modal itself lives in VideoModal.astro, rendered once from
    Layout.astro. The .video-card button above opens it via its data-* attrs. */}

<style>
  .about {
    background: var(--white);
  }

  /* Head spans the full width above the two columns. */
  .about__head {
    margin-bottom: 54px;
  }

  .about__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy-700);
  }

  .about__eyebrow img {
    width: 30px;
    height: auto;
    flex: none;
  }

  .about__title {
    max-width: 1080px; /* the project's long-form text ceiling */
    font-size: clamp(34px, 2.2785vw + 1.1994rem, 52px);
    line-height: 1.12;
  }

  /* Block so the italic phrase always starts its own line, rather than
     wrapping wherever the column width happens to land. */
  .about__title em {
    display: block;
    font-style: italic;
    color: var(--navy-500);
  }

  /* Sidebar + content on the 3-column grid: aside 1 col, copy spans 2. */
  .about__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--section-gap);
    align-items: start;
  }

  .about__body {
    grid-column: span 2;
  }

  /* ---- Video card ---- */
  .video-card {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--navy-900);
    text-align: left;
  }

  .video-card__poster {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center;
  }

  /* Scrim so the caption stays readable over the photo. */
  .video-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 36, 56, 0) 45%,
      rgba(15, 36, 56, 0.82) 100%
    );
  }

  .video-card__play {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.92);
    color: var(--navy-900);
    transition: background var(--dur-base) var(--ease-out);
  }

  .video-card:hover .video-card__play {
    background: var(--gold-500);
  }

  .video-card__play svg {
    width: 20px;
    height: 20px;
    margin-left: 2px;
  }

  .video-card__meta {
    position: absolute;
    right: 18px;
    bottom: 16px;
    left: 18px;
    z-index: 1;
    display: block;
    color: #fff;
  }

  .video-card__label {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-ui);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }

  .video-card__caption {
    display: block;
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.35;
  }

  /* ---- Testimonial ---- */
  .testimonial {
    margin: 40px 0 0;
  }

  .testimonial__stars {
    display: flex;
    gap: 4px;
    margin-bottom: 20px;
    color: var(--gold-500);
  }

  .testimonial__stars svg {
    width: 27px;
    height: 27px;
  }

  .testimonial__quote {
    margin: 0 0 20px;
    font-family: var(--font-serif);
    font-size: clamp(19px, 0.2532vw + 1.0847rem, 21px);
    font-style: italic;
    line-height: 1.5;
    color: var(--ink-700);
  }

  .testimonial__name {
    display: block;
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 700;
    color: var(--navy-700);
    line-height: 1;
  }

  .testimonial__case {
    display: block;
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-500);
  }

  /* ---- Body copy ---- */
  /* Scoped under .about__body so it outranks the `.about__body p` rule
     below, which would otherwise flatten it back to the body colour. */
  .about__body .about__lead {
    margin-bottom: 22px;
    font-size: 18px;
    font-weight: 500;
    line-height: 31px;
    color: var(--ink-900);
  }

  .about__body p {
    margin-bottom: 22px;
    color: var(--ink-500);
  }

  .about__body h3 {
    margin: 40px 0 14px;
    font-size: clamp(23px, 0.3797vw + 1.2832rem, 26px);
    line-height: 1.25;
  }

  /* ---- Checklist ---- */
  .checklist {
    list-style: none;
    margin: 0 0 34px;
    padding: 0;
  }

  .checklist li {
    display: flex;
    gap: 14px;
    margin-bottom: 18px;
    color: var(--ink-500);
  }

  .checklist strong {
    font-weight: 700;
    color: var(--ink-900);
  }

  .checklist__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 3px;
    border-radius: var(--radius-pill);
    background: var(--gold-300);
    color: var(--white);
  }

  .checklist__icon svg {
    width: 13px;
    height: 13px;
  }

  /* ---- Pull quote ---- */
  .pullquote {
    margin: 0 0 40px;
    padding: 34px 38px;
    background: var(--bone-100);
    border-left: 3px solid var(--gold-500);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .pullquote blockquote {
    margin: 0 0 22px;
    font-family: var(--font-serif);
    font-size: clamp(20px, 0.3797vw + 1.0957rem, 23px);
    font-style: italic;
    line-height: 1.45;
    color: var(--navy-700);
  }

  .pullquote figcaption {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .pullquote img {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-pill);
    object-fit: cover;
  }

  .pullquote__name {
    display: block;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    color: var(--navy-700);
    line-height: 1;
  }

  .pullquote__role {
    display: block;
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-600);
  }

  .about__cta {
    margin-top: 12px;
    padding: 12px 34px;
  }

  /* Tablet — collapse to a single column, media first. */
  @media (max-width: 1000px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .about__body {
      grid-column: auto;
    }

    .about__aside {
      max-width: 520px;
    }

    .about__head {
      margin-bottom: 40px;
    }
  }

  @media (max-width: 650px) {
    .about__eyebrow {
      font-size: 13px;
      letter-spacing: 0.14em;
    }

    .about__lead {
      font-size: 17px;
      line-height: 29px;
    }

    .about__body h3 {
      margin-top: 34px;
    }

    .pullquote {
      padding: 26px 24px;
    }

    .about__cta {
      width: 100%;
    }
  }
</style>
