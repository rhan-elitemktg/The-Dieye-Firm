---
/* One paragraph of fa__text's run. Exists only to put the class back on: see the
   `block` prop note in prose/ParagraphRun.astro. A bare :global(p) would also catch .fa__role, which sits in the same card. */
interface Props {
  node?: unknown;
  index?: number;
  isInline?: boolean;
}

const { node, index, isInline, ...attrs } = Astro.props;
---

<p class="fa__text" {...attrs}><slot /></p>
