---
// Blog — "We're Keeping You Informed". One featured post on the left, three
// recent posts stacked on the right.

import { Image } from "astro:assets";
import birdGold from "../../assets/images/logo-bird-gold.png";
import featImg from "../../assets/images/blog/blog-feat.webp";
import post1Img from "../../assets/images/blog/blog-post-1.webp";
import post2Img from "../../assets/images/blog/blog-post-2.webp";
import post3Img from "../../assets/images/blog/blog-post-3.webp";

/* PLACEHOLDER POSTS — replaced by a Sanity query at integration.
   The shape is deliberately what a `post` document will return, so the swap is
   a query and a map rather than a rewrite: the ISO date drives both the
   <time datetime> and the display string, and `href` becomes /blog/{slug}.

   The images are the reference design's, and they are small (400x224). They
   upscale on the featured slot until real post artwork lands. */
const author = "The Dieye Firm";

const featured = {
  title: "Preparing Emotionally for Mediation",
  href: "/blog/",
  date: "2026-04-01",
  image: featImg,
  excerpt:
    "Practical, compassionate ways to steady your mindset and walk into the mediation room with clarity, confidence, and a real sense of calm.",
};

const posts = [
  {
    title: "New Year, New Beginnings: Is Divorce Part of Your Resolution for a Fresh Start?",
    href: "/blog/",
    date: "2026-01-04",
    image: post1Img,
  },
  {
    title: "Does Remarriage Affect Child Support Obligations?",
    href: "/blog/",
    date: "2025-10-01",
    image: post2Img,
  },
  {
    title: "Mediation for High-Conflict Divorces: Is It Still Possible?",
    href: "/blog/",
    date: "2025-07-06",
    image: post3Img,
  },
];

/* en-GB gives "01 April 2026" — day first, no comma — which is the format in
   the design. Built from the ISO string so the markup and the machine-readable
   attribute can't drift. */
const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });
---

<section class="blog section" aria-labelledby="blog-title">
  <div class="container">
    <header class="blog__head">
      <p class="blog__eyebrow">
        <Image src={birdGold} alt="" width={70} format="webp" loading="lazy" decoding="async" />
        <span>Our Blog</span>
      </p>
      <h2 class="blog__title" id="blog-title">We're Keeping You <em>Informed</em></h2>
    </header>

    <div class="blog__grid">
      <article class="blog-feat">
        {/* The whole card is one link via the title's ::after, so the image and
            heading are a single tab stop rather than two to the same place. */}
        <a class="blog-feat__media" href={featured.href} tabindex="-1" aria-hidden="true">
          <Image
            src={featured.image}
            alt=""
            widths={[400, 600, 800]}
            sizes="(max-width: 1000px) 92vw, 46vw"
            format="webp"
            quality={80}
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="blog__meta">
          <time datetime={featured.date}>{formatDate(featured.date)}</time>
          <span class="blog__sep" aria-hidden="true">|</span>
          <span>by <b>{author}</b></span>
        </p>
        <h3 class="blog-feat__title">
          <a href={featured.href}>{featured.title}</a>
        </h3>
        <p class="blog-feat__excerpt">{featured.excerpt}</p>
      </article>

      <ul class="blog__list">
        {posts.map((post) => (
          <li>
            <article class="blog-item">
              <a class="blog-item__media" href={post.href} tabindex="-1" aria-hidden="true">
                <Image
                  src={post.image}
                  alt=""
                  widths={[300, 400, 600]}
                  sizes="(max-width: 650px) 40vw, (max-width: 1000px) 300px, 20vw"
                  format="webp"
                  quality={80}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="blog-item__body">
                <p class="blog__meta">
                  <time datetime={post.date}>{formatDate(post.date)}</time>
                  <span class="blog__sep" aria-hidden="true">|</span>
                  <span class="blog__author">by <b>{author}</b></span>
                </p>
                <h3 class="blog-item__title">
                  <a href={post.href}>{post.title}</a>
                </h3>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>

    <div class="blog__cta">
      <a class="btn btn--gold" href="/blog/">View All Blog Posts</a>
    </div>
  </div>
</section>

<style>
  .blog {
    background: var(--white);
  }

  /* ---- Head ---- */
  .blog__head {
    margin-bottom: 48px;
    text-align: center;
  }

  .blog__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy-700);
  }

  .blog__eyebrow img {
    width: 30px;
    height: auto;
    flex: none;
  }

  .blog__title {
    font-size: clamp(34px, 2.2785vw + 1.1994rem, 52px);
    line-height: 1.12;
  }

  .blog__title em {
    font-style: italic;
    color: var(--gold-600);
  }

  /* ---- Grid ---- */
  .blog__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: start;
  }

  /* ---- Shared meta line ---- */
  .blog__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink-500);
  }

  .blog__meta b {
    font-weight: 700;
    color: var(--gold-600);
  }

  .blog__sep {
    color: var(--bone-400);
  }

  /* ---- Featured ---- */
  /* isolate so the title link's ::after overlay can't escape the card. */
  .blog-feat {
    position: relative;
    isolation: isolate;
  }

  .blog-feat__media {
    display: block;
    margin-bottom: 22px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .blog-feat__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .blog-feat__title {
    margin-bottom: 12px;
    font-size: clamp(26px, 1.2658vw + 1.1013rem, 36px);
    line-height: 1.3;
    color: var(--navy-700);
  }

  .blog-feat__title a {
    color: inherit;
  }

  /* The card-wide hit area. The image and its link are aria-hidden and
     untabbable, so this is the single accessible link for the whole card. */
  .blog-feat__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .blog-feat:hover .blog-feat__media img {
    transform: scale(1.03);
  }

  .blog-feat:hover .blog-feat__title a {
    color: var(--gold-600);
  }

  .blog-feat__excerpt {
    color: var(--ink-500);
  }

  /* ---- List ---- */
  .blog__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blog__list li + li {
    margin-top: 25px;
    padding-top: 25px;
    border-top: 1px solid var(--bone-300);
  }

  .blog-item {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 28px;
    align-items: center;
  }

  .blog-item__media {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .blog-item__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 14 / 9;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .blog-item__title {
    font-size: clamp(19px, 0.6329vw + 0.8873rem, 24px);
    line-height: 1.45;
    color: var(--navy-700);
  }

  .blog-item__title a {
    color: inherit;
  }

  .blog-item__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .blog-item:hover .blog-item__media img {
    transform: scale(1.04);
  }

  .blog-item:hover .blog-item__title a {
    color: var(--gold-600);
  }

  /* ---- CTA ---- */
  .blog__cta {
    margin-top: 56px;
    text-align: center;
  }

  .blog__cta .btn {
    min-width: 260px;
    padding: 12px 34px;
  }

  /* Small Desktop */
  @media (max-width: 1439px) {
    .blog__grid {
      gap: 48px;
    }

    .blog-item {
      grid-template-columns: 220px 1fr;
      gap: 22px;
    }
  }

  /* Tablet — the two columns stack, so the featured post sits above the list
     and the thumbnails can go back to a comfortable width. */
  @media (max-width: 1000px) {
    .blog__head {
      margin-bottom: 40px;
    }

    .blog__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .blog-feat__media img {
      aspect-ratio: 16 / 9;
    }

    .blog-item {
      grid-template-columns: 300px 1fr;
      gap: 28px;
    }
  }

  /* Mobile */
  @media (max-width: 650px) {
    .blog__eyebrow {
      font-size: 13px;
      letter-spacing: 0.14em;
    }

    .blog__meta {
      font-size: 13px;
    }

    /* The compact items only get ~55% of a phone's width, which isn't enough
       for date + author on one line — it wrapped into a four-line block. The
       byline is the same on every post, so the date carries the useful
       information and the attribution stays on the featured post above. */
    .blog-item .blog__author,
    .blog-item .blog__sep {
      display: none;
    }

    /* The thumbnail keeps its own column rather than stacking — a full-width
       400px-wide source would upscale badly, and the two-column row keeps
       each item scannable. */
    .blog-item {
      grid-template-columns: 40% 1fr;
      gap: 16px;
      align-items: start;
    }

    .blog__cta {
      margin-top: 36px;
    }

    .blog__cta .btn {
      width: 100%;
    }
  }
</style>
