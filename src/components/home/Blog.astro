---
// Blog — "We're Keeping You Informed". One featured post on the left, three
// recent posts stacked on the right.

import { Image } from "astro:assets";
import { getBlogPosts } from "../../sanity/blogPosts";
import birdGold from "../../assets/images/logo-bird-gold.png";
import fallbackImg from "../../assets/images/blog/blog-img.jpg";
import { responsiveImage } from "../../sanity/image";
import { byNewest, formatDate, isoDate, postHref } from "../blog/blog";

/* Real posts, ingested from the live archive by `npm run scrape:blog`. This
   used to be a placeholder array shaped like a future Sanity `post`; the
   collection now supplies the same fields, so the eventual Sanity swap is
   still a query change rather than a rewrite. */
const all = (await getBlogPosts()).sort(byNewest);
const [featured, ...rest] = all;
const posts = rest.slice(0, 3);

/* The byline is the firm on every post, so it stays a single value here
   rather than being read per card. */
const author = featured.data.author;
---

<section class="blog section" aria-labelledby="blog-title">
  <div class="container">
    <header class="blog__head">
      <p class="blog__eyebrow">
        <Image src={birdGold} alt="" width={70} format="webp" loading="lazy" decoding="async" />
        <span>Our Blog</span>
      </p>
      <h2 class="blog__title" id="blog-title">We're Keeping You <em>Informed</em></h2>
    </header>

    <div class="blog__grid">
      <article class="blog-feat">
        {/* The whole card is one link via the title's ::after, so the image and
            heading are a single tab stop rather than two to the same place. */}
        <a class="blog-feat__media" href={postHref(featured)} tabindex="-1" aria-hidden="true">
          {featured.data.image ? (
            <img
              {...responsiveImage(featured.data.image, [400, 600, 800])}
              sizes="(max-width: 1000px) 92vw, 46vw"
              alt=""
              loading="lazy"
              decoding="async"
            />
          ) : (
            <Image
              src={fallbackImg}
              alt=""
              widths={[400, 600, 800]}
              sizes="(max-width: 1000px) 92vw, 46vw"
              format="webp"
              quality={80}
              loading="lazy"
              decoding="async"
            />
          )}
        </a>
        <p class="blog__meta">
          <time datetime={isoDate(featured.data.date)}>{formatDate(featured.data.date)}</time>
          <span class="blog__sep" aria-hidden="true">|</span>
          <span>by <b>{author}</b></span>
        </p>
        <h3 class="blog-feat__title">
          <a href={postHref(featured)}>{featured.data.title}</a>
        </h3>
        <p class="blog-feat__excerpt">{featured.data.description}</p>
      </article>

      <ul class="blog__list">
        {posts.map((post) => (
          <li>
            <article class="blog-item">
              <a class="blog-item__media" href={postHref(post)} tabindex="-1" aria-hidden="true">
                {post.data.image ? (
                  <img
                    {...responsiveImage(post.data.image, [300, 400, 600])}
                    sizes="(max-width: 650px) 40vw, (max-width: 1000px) 300px, 20vw"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Image
                    src={fallbackImg}
                    alt=""
                    widths={[300, 400, 600]}
                    sizes="(max-width: 650px) 40vw, (max-width: 1000px) 300px, 20vw"
                    format="webp"
                    quality={80}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </a>
              <div class="blog-item__body">
                <p class="blog__meta">
                  <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
                  <span class="blog__sep" aria-hidden="true">|</span>
                  <span class="blog__author">by <b>{author}</b></span>
                </p>
                <h3 class="blog-item__title">
                  <a href={postHref(post)}>{post.data.title}</a>
                </h3>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>

    <div class="blog__cta">
      <a class="btn btn--gold" href="/blog/">View All Blog Posts</a>
    </div>
  </div>
</section>

<style>
  .blog {
    background: var(--white);
  }

  /* ---- Head ---- */
  .blog__head {
    margin-bottom: 48px;
    text-align: center;
  }

  .blog__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy-700);
  }

  .blog__eyebrow img {
    width: 30px;
    height: auto;
    flex: none;
  }

  .blog__title {
    font-size: clamp(34px, 2.2785vw + 1.1994rem, 52px);
    line-height: 1.12;
  }

  .blog__title em {
    font-style: italic;
    color: var(--gold-600);
  }

  /* ---- Grid ---- */
  .blog__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: start;
  }

  /* ---- Shared meta line ---- */
  .blog__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink-500);
  }

  .blog__meta b {
    font-weight: 700;
    color: var(--gold-600);
  }

  .blog__sep {
    color: var(--bone-400);
  }

  /* ---- Featured ---- */
  /* isolate so the title link's ::after overlay can't escape the card. */
  .blog-feat {
    position: relative;
    isolation: isolate;
  }

  .blog-feat__media {
    display: block;
    margin-bottom: 22px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .blog-feat__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .blog-feat__title {
    margin-bottom: 12px;
    font-size: clamp(26px, 1.2658vw + 1.1013rem, 36px);
    line-height: 1.3;
    color: var(--navy-700);
  }

  .blog-feat__title a {
    color: inherit;
  }

  /* The card-wide hit area. The image and its link are aria-hidden and
     untabbable, so this is the single accessible link for the whole card. */
  .blog-feat__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .blog-feat:hover .blog-feat__media img {
    transform: scale(1.03);
  }

  .blog-feat:hover .blog-feat__title a {
    color: var(--gold-600);
  }

  .blog-feat__excerpt {
    color: var(--ink-500);
  }

  /* ---- List ---- */
  .blog__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blog__list li + li {
    margin-top: 25px;
    padding-top: 25px;
    border-top: 1px solid var(--bone-300);
  }

  .blog-item {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 28px;
    align-items: center;
  }

  .blog-item__media {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .blog-item__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 14 / 9;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .blog-item__title {
    font-size: clamp(19px, 0.6329vw + 0.8873rem, 24px);
    line-height: 1.45;
    color: var(--navy-700);
  }

  .blog-item__title a {
    color: inherit;
  }

  .blog-item__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .blog-item:hover .blog-item__media img {
    transform: scale(1.04);
  }

  .blog-item:hover .blog-item__title a {
    color: var(--gold-600);
  }

  /* ---- CTA ---- */
  .blog__cta {
    margin-top: 56px;
    text-align: center;
  }

  .blog__cta .btn {
    min-width: 260px;
    padding: 12px 34px;
  }

  /* Small Desktop */
  @media (max-width: 1439px) {
    .blog__grid {
      gap: 48px;
    }

    .blog-item {
      grid-template-columns: 220px 1fr;
      gap: 22px;
    }
  }

  /* Tablet — the two columns stack, so the featured post sits above the list
     and the thumbnails can go back to a comfortable width. */
  @media (max-width: 1000px) {
    .blog__head {
      margin-bottom: 40px;
    }

    .blog__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .blog-feat__media img {
      aspect-ratio: 16 / 9;
    }

    .blog-item {
      grid-template-columns: 300px 1fr;
      gap: 28px;
    }
  }

  /* Mobile */
  @media (max-width: 650px) {
    .blog__eyebrow {
      font-size: 13px;
      letter-spacing: 0.14em;
    }

    .blog__meta {
      font-size: 13px;
    }

    /* The compact items only get ~55% of a phone's width, which isn't enough
       for date + author on one line — it wrapped into a four-line block. The
       byline is the same on every post, so the date carries the useful
       information and the attribution stays on the featured post above. */
    .blog-item .blog__author,
    .blog-item .blog__sep {
      display: none;
    }

    /* The thumbnail keeps its own column rather than stacking — a full-width
       400px-wide source would upscale badly, and the two-column row keeps
       each item scannable. */
    .blog-item {
      grid-template-columns: 40% 1fr;
      gap: 16px;
      align-items: start;
    }

    .blog__cta {
      margin-top: 36px;
    }

    .blog__cta .btn {
      width: 100%;
    }
  }
</style>
