---
// FamilyLawNav — the practice-area menu in the sidebar.
//
// One state on every one of the 32 pages: all 11 top-level areas, with a "+"
// on the five that have children and an arrow on the rest. The branch you are
// in opens by default, so the page you are on is always visible in the list
// rather than hidden behind a "+" you have to find.
//
// It used to have a second state — a branch page listed only its own children
// — because the flat list ran to 18 rows and was too tall to show everywhere.
// Re-parenting eight areas took it to 11 rows and removed that reason, so the
// menu is the same everywhere and the sidebar stops changing shape underneath
// someone moving through the section.
//
// The markup and the styling live in TreeNav now, shared with the location
// pages' menu. What stays here is everything that is about practice areas:
// which page is a parent, which branch to open, and that the card heads the
// section INDEX rather than the section.
//
// It also renders OUTSIDE the section, on the About Us pages, whose live
// versions carry the same cross-reference. There `current` is omitted: nothing
// is highlighted and every branch starts collapsed. Any page rendering this
// must do the two things the practice-area route does — stamp `data-pa-boot`
// on <html> from a blocking head script, and call initPracticeAreaNav() —
// or the branches render open and the "+" buttons do nothing.

import TreeNav from "../interior/TreeNav.astro";
import { areaHref, branchOf, buildTree, type PracticeArea } from "./practiceAreas";

interface Props {
  areas: PracticeArea[];

  /* Omitted when the menu is rendered somewhere outside the section — the
     About Us pages carry it as a cross-reference, and no row there is "the
     page you are on". Without it nothing is highlighted and every branch
     starts collapsed, which is the right resting state for a menu that is
     pointing away from the current page rather than locating you within it. */
  current?: PracticeArea;
}

const { areas, current } = Astro.props;

const rows = buildTree(areas).map(({ area, children }) => ({
  id: area.id,
  label: area.data.navLabel,
  href: areaHref(area),
  children: children.map((child) => ({
    id: child.id,
    label: child.data.navLabel,
    href: areaHref(child),
  })),
}));

/* The branch to open: this page if it is a parent, its parent if it is a
   child, and nothing if it is a childless top-level area — or if there is no
   current page at all. */
const openId = current ? branchOf(current) : undefined;
---

{/* Titled and linked for the section INDEX, /practice-areas/. Not
    /family-law/ — that is one of the rows in the list below now, and a card
    titled "Family Law" containing a row called "Family Law" reads as a bug. */}
<TreeNav
  title="Practice Areas"
  cardId="fl-nav"
  cardHref="/practice-areas/"
  rowIdPrefix="fl"
  rows={rows}
  currentId={current?.id}
  openId={openId}
/>
