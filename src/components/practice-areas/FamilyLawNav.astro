---
// FamilyLawNav — the practice-area menu in the sidebar.
//
// Two states, driven by whether the page you are on has children:
//
//   Branch page (Divorce, Child Custody) — lists only that page's children.
//     You have arrived at the topic; the sidebar's job is now to show what is
//     inside it, not to re-offer the other sixteen.
//
//   Everything else (the 16 childless top-level areas, and all 13 child pages)
//     — lists all 18 top-level areas. Areas with children carry a "+" that
//     opens them in place; areas without carry an arrow, because a control
//     that expands nothing should not look like one that does.
//
// On a child page the parent branch opens by default, so the page you are on
// is visible in the list rather than hidden behind a "+" you have to find.
//
// The "+" is a real button with aria-expanded, bound by src/scripts/pa-nav.ts
// from the route — the same split Layout uses for lead-form.ts. Without JS
// every branch renders open, so no link is ever unreachable.

import SidebarCard from "../blog/SidebarCard.astro";
import { areaHref, branchOf, buildTree, type PracticeArea } from "./practiceAreas";

interface Props {
  areas: PracticeArea[];
  current: PracticeArea;
}

const { areas, current } = Astro.props;

const tree = buildTree(areas);

/* A branch page shows its own children; everything else shows the full index.
   One lookup decides it, so the title and the rows can't describe different
   things. */
const ownBranch = tree.find((branch) => branch.area.id === current.id);
const showsOwnChildren = (ownBranch?.children.length ?? 0) > 0;

const openBranch = branchOf(current);
const rowId = (area: PracticeArea) => `fl-${area.id.replace(/\//g, "-")}`;
---

{
  showsOwnChildren ? (
    /* ---- Branch page: its children only ---- */
    <SidebarCard title={current.data.navLabel} id="fl-nav">
      <ul class="fl">
        {ownBranch!.children.map((child) => (
          <li class="fl__row">
            <a class="fl__link" href={areaHref(child)}>
              <span>{child.data.navLabel}</span>
              <span class="fl__mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path
                    d="M5 12h13m-5-6 6 6-6 6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>

      {/* Without this the card is a dead end: from inside a branch there is no
          way back out to the other sixteen areas. */}
      <a class="fl__all" href="/family-law/">View All +</a>
    </SidebarCard>
  ) : (
    /* ---- Everything else: the full index ---- */
    <SidebarCard title="Family Law" id="fl-nav" href="/family-law/">
      <ul class="fl">
        {tree.map(({ area, children }) => {
          const hasKids = children.length > 0;
          const isOpen = hasKids && area.id === openBranch;
          const isCurrent = area.id === current.id;

          return (
            <li class:list={["fl__row", { "is-expanded": isOpen }]}>
              <div class="fl__head">
                <a
                  class:list={["fl__link", { "is-active": isCurrent }]}
                  href={areaHref(area)}
                  aria-current={isCurrent ? "page" : undefined}
                >
                  <span>{area.data.navLabel}</span>

                  {!hasKids && (
                    <span class="fl__mark" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none">
                        <path
                          d="M5 12h13m-5-6 6 6-6 6"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                  )}
                </a>

                {hasKids && (
                  <button
                    class="fl__toggle"
                    type="button"
                    data-pa-toggle
                    aria-expanded={isOpen ? "true" : "false"}
                    aria-controls={rowId(area)}
                  >
                    <span class="visually-hidden">
                      {`Show pages under ${area.data.navLabel}`}
                    </span>
                    <span class="fl__mark" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none">
                        <path
                          d="M12 5v14M5 12h14"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                        />
                      </svg>
                    </span>
                  </button>
                )}
              </div>

              {hasKids && (
                <ul class="fl__kids" id={rowId(area)}>
                  {children.map((child) => (
                    <li>
                      <a
                        class:list={["fl__kid", { "is-active": child.id === current.id }]}
                        href={areaHref(child)}
                        aria-current={child.id === current.id ? "page" : undefined}
                      >
                        {child.data.navLabel}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </SidebarCard>
  )
}

<style>
  .fl {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl__row + .fl__row {
    border-top: 1px solid var(--bone-300);
  }

  .fl__head {
    display: flex;
    align-items: stretch;
  }

  .fl__link {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-width: 0;
    padding: 15px 0;
    font-family: var(--font-ui);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--navy-700);
    text-decoration: none;
    transition: color var(--dur-base) var(--ease-out);
  }

  .fl__link:hover {
    color: var(--gold-600);
  }

  /* The page you are on. Weight and colour, plus aria-current on the element
     itself so it doesn't rest on colour alone. */
  .fl__link.is-active {
    color: var(--gold-600);
    font-weight: 700;
  }

  /* Both glyphs share a box, so a "+" row and an arrow row line up exactly. */
  .fl__mark {
    display: flex;
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--gold-500);
    transition: color var(--dur-base) var(--ease-out);
  }

  .fl__mark svg {
    width: 100%;
    height: 100%;
  }

  .fl__link:hover .fl__mark {
    color: var(--gold-600);
  }

  /* ---- The expand control ---- */

  /* A button, not a second link: it changes the state of this list rather than
     going anywhere. Padded left so its hit area doesn't crowd the label. */
  .fl__toggle {
    display: flex;
    align-items: center;
    flex: none;
    padding: 0 0 0 14px;
    margin: 0;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--gold-500);
    transition: color var(--dur-base) var(--ease-out);
  }

  .fl__toggle:hover {
    color: var(--gold-600);
  }

  /* Colour is inherited from the button above, so this only adds the rotation
     — listing both here would override the inherited colour transition. */
  .fl__toggle .fl__mark {
    transition:
      transform var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  /* The plus turns a quarter turn into a cross when open — the same gesture
     the homepage FAQ accordion uses. */
  .fl__row.is-expanded .fl__toggle .fl__mark {
    transform: rotate(45deg);
  }

  /* ---- Children ---- */

  /* Hung off a hairline and indented, so the group reads as belonging to the
     row above rather than as more siblings. */
  .fl__kids {
    margin: 0 0 14px;
    padding: 2px 0 0 16px;
    list-style: none;
    border-left: 1px solid var(--bone-300);
  }

  /* Closed by default only when the script is there to open them again.
     `data-pa-boot` is stamped on <html> by a blocking head script, so a closed
     branch is never painted open first — the same trick FilterBoot uses on the
     Blog index, and for the same reason: collapsing 10 rows after first paint
     reads as a bug. Without JS the attribute is absent, every branch stays
     open, and no page in the section is unreachable. */
  :global(html[data-pa-boot]) .fl__row:not(.is-expanded) .fl__kids {
    display: none;
  }

  .fl__kid {
    display: block;
    padding: 9px 0;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-500);
    text-decoration: none;
    transition: color var(--dur-base) var(--ease-out);
  }

  .fl__kid:hover {
    color: var(--gold-600);
  }

  .fl__kid.is-active {
    color: var(--gold-600);
    font-weight: 700;
  }

  /* ---- Footer link, branch pages only ---- */
  .fl__all {
    display: block;
    margin-top: 4px;
    padding: 16px 0 4px;
    border-top: 1px solid var(--bone-300);
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-600);
    text-decoration: none;
    transition: color var(--dur-base) var(--ease-out);
  }

  .fl__all:hover {
    color: var(--navy-700);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .fl__toggle .fl__mark {
      transition: none;
    }
  }
</style>
