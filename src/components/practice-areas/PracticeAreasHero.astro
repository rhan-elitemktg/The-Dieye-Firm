---
// Practice Areas hero — full-bleed storefront photo with a navy side-scrim
// holding the copy on the left.
//
// Same structure as about/PapaHero.astro, which solves the identical problem:
// a bright photo with Papa in the right third, copy on the left, and the
// header in flow above rather than overlaying it. The scrim here is a little
// heavier because the left third of this frame is blown-out sky, and contrast
// has to clear 4.5:1 against the brightest region rather than the average.
//
// The source is 1247x741, so `widths` stops at its native width — asking Astro
// for a 1920 variant would upscale rather than sharpen. The browser takes the
// 1247 file and the band stretches it, which is the same trade PapaHero makes.

import { Image } from "astro:assets";
import Eyebrow from "../Eyebrow.astro";
import storefront from "../../assets/images/hero-practice.jpg";
---

<section class="pxhero">
  <div class="pxhero__media">
    <Image
      class="pxhero__img"
      src={storefront}
      alt="Attorney Papa Dieye outside the brick storefronts in Old Town Pearland"
      widths={[768, 1024, 1247]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="pxhero__scrim" aria-hidden="true"></div>
  </div>

  <div class="container pxhero__inner">
    <div class="pxhero__content">
      <Eyebrow light eager>Practice Areas</Eyebrow>

      <h1 class="pxhero__title">
        How we help <em>Texas families.</em>
      </h1>

      {/* The comp's em dash becomes a spaced hyphen, per AGENTS.md. */}
      <p class="pxhero__lead">
        From divorce and custody to support and modifications, Papa Dieye guides
        Pearland and Houston families through every family law matter - with
        steady, compassionate counsel and honest answers.
      </p>

      <a class="btn btn--gold pxhero__cta" href="/contact-us/">
        Schedule a Consultation
      </a>
    </div>
  </div>
</section>

<style>
  .pxhero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: 640px;
    overflow: hidden;
    background: var(--navy-900);
  }

  .pxhero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .pxhero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Papa stands in the right third, so the crop is anchored right: as the
       viewport narrows the empty street is given up before he is. Anchored top
       vertically so any vertical overflow is trimmed off the pavement rather
       than off his head. */
    object-position: 72% top;
    filter: var(--photo-filter);
  }

  /* Heavier than PapaHero's at the left end: this frame opens on blown-out sky
     rather than shopfront, so the copy needs solid navy under it well past the
     third. */
  .pxhero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--navy-900) 0%,
      color-mix(in srgb, var(--navy-900) 88%, transparent) 42%,
      color-mix(in srgb, var(--navy-900) 34%, transparent) 68%,
      transparent 94%
    );
  }

  /* The header sits in flow above this section, so the hero carries no offset
     for it. */
  .pxhero__inner {
    padding-block: 96px 90px;
  }

  .pxhero__content {
    max-width: 760px;
  }

  .pxhero__title {
    margin: 22px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(40px, 3.2911vw + 1.163rem, 66px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
    max-width: 20ch;
  }

  .pxhero__title em {
    font-style: italic;
    color: var(--gold-500);
  }

  .pxhero__lead {
    max-width: 620px;
    margin-top: 28px;
    font-size: 18px;
    line-height: 30px;
    color: rgba(255, 255, 255, 0.9);
    text-wrap: pretty;
  }

  .pxhero__cta {
    margin-top: 40px;
    padding: 14px 30px;
  }

  /* Tablet — less room for the photo, so the scrim tightens up to keep the
     headline legible where it now overlaps him. */
  @media (max-width: 1000px) {
    .pxhero {
      min-height: 540px;
    }

    .pxhero__scrim {
      background: linear-gradient(
        90deg,
        var(--navy-900) 0%,
        color-mix(in srgb, var(--navy-900) 90%, transparent) 48%,
        color-mix(in srgb, var(--navy-900) 56%, transparent) 80%,
        color-mix(in srgb, var(--navy-900) 22%, transparent) 100%
      );
    }

    .pxhero__inner {
      padding-bottom: 72px;
    }

    .pxhero__content {
      max-width: 620px;
    }
  }

  /* Mobile — a side-scrim can't work at this width: the copy would sit on top
     of Papa whatever the gradient does, so dimming it enough to read means
     losing him entirely. The photo drops into flow as its own band with the
     copy on solid navy beneath, the same as PapaHero and the homepage hero. */
  @media (max-width: 650px) {
    .pxhero {
      min-height: 0;
    }

    .pxhero__media {
      position: relative;
      inset: auto;
      z-index: auto;
      height: clamp(300px, 46svh, 400px);
    }

    /* Nothing overlays the band now, so the crop can sit on him properly. */
    .pxhero__img {
      object-position: 76% center;
    }

    .pxhero__scrim {
      background: linear-gradient(
        180deg,
        rgba(15, 36, 56, 0) 0%,
        rgba(15, 36, 56, 0.18) 52%,
        rgba(15, 36, 56, 0.72) 84%,
        var(--navy-900) 100%
      );
    }

    .pxhero__inner {
      padding-block: 28px 56px;
    }

    .pxhero__lead {
      font-size: 17px;
      line-height: 29px;
      margin-top: 22px;
    }

    .pxhero__cta {
      margin-top: 32px;
      width: 100%;
    }
  }
</style>
