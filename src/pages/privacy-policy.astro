---
// Privacy Policy — the firm's own published policy, on the interior
// main+sidebar template.
//
// WHERE THE COPY COMES FROM. There is no comp for this page, and none is
// possible: a privacy policy is a legal commitment on the firm's behalf, so
// the only defensible source is the firm's own published text. These 888 words
// are taken verbatim from dieyelaw.com/privacy-policy/, which is live and
// returns 200 today. Same rule as
// /about-us/choosing-a-family-law-attorney/ and the five ingested bodies:
// AGENTS.md's "leave the client's published prose alone" governs every
// sentence below.
//
// The live page has NO data-content container of the shape AGENTS.md's grep
// looks for, because that grep is anchored on `id="…" … data-content` and this
// page's block carries no id. It is `#PrivacyPolicyS1 > .cnt-stl[data-content]`,
// a single container holding the whole policy — measured, not assumed: the
// section is 888 words and the block is 888 words, so nothing sits outside it.
// (Enumerating on the id-anchored pattern alone would have reported "no
// containers" on a page that has one. Worth knowing before the next ingest.)
//
// No redirect is involved. The live URL is /privacy-policy/ and so is ours.
// It is NOT in dieyelaw.com/sitemap.xml, so it carries no equity by AGENTS.md's
// test — but the URL matches exactly regardless, so there is nothing to add to
// vercel.json either way.
//
// THREE DELIBERATE DEVIATIONS from verbatim, listed here the way ReviewWall and
// the Choosing guide list their own. Add to this list rather than editing a
// sentence silently:
//
//   1. Straight quotes and apostrophes are curled. The source is pure ASCII —
//      "cookies", "https", visitor's — which renders as typewriter punctuation
//      next to every other page on the site. This is typography, not prose: no
//      word, order or emphasis changes.
//   2. The phone number and street address in the closing paragraph render from
//      the firmDetails singleton rather than as literal text. The source says
//      "12280 Broadway Street, Suite 3105"; firmDetails says "12280 W Broadway
//      St Ste 3105", which is what the footer, the contact page and the
//      LegalService markup all emit. A privacy policy whose address disagrees
//      with the rest of the site is worse than one that differs from the old
//      page, and AGENTS.md already forbids hardcoding the phone number.
//      The phone also becomes a tel: link, which the source's plain text isn't.
//   3. The h2s are the client's own. Unlike the Choosing guide, this page came
//      with its eight headings, so none of them is ours.
//
// The trailing "This policy was last updated…" line that some policies carry is
// absent from the source, and is NOT invented here — the same call AuthorCard
// makes about dates it doesn't have. It arrives in the Sanity pass, with a real
// value the firm supplies.

import Layout from "../layouts/Layout.astro";
import Header from "../components/header/Header.astro";
import InteriorShell from "../components/interior/InteriorShell.astro";
import InteriorHeader from "../components/interior/InteriorHeader.astro";
import AboutSidebar from "../components/about/AboutSidebar.astro";
import { getFirmDetails } from "../sanity/firmDetails";

const firm = await getFirmDetails();

const canonical = new URL("/privacy-policy/", Astro.site ?? Astro.url).href;

const description =
  "How The Dieye Firm collects, uses, shares and protects the information you provide through dieyelaw.com.";

/* Kept as named arrays so the Sanity sweep is a query and a map rather than a
   re-typing — the same shape ReviewWall's `reviews`, Hero's `stats` and the
   Choosing guide's `sections` already use.

   `blocks` rather than the Choosing guide's flat `paragraphs` because the
   Sharing section puts a list BETWEEN two runs of prose, so order matters and a
   separate `list` field would lose it. Each block is one Portable Text block
   when this is modelled: { p } becomes a paragraph, { ul } a bulleted list.
   `contact` is the one block that interpolates — see deviation 2. */
const intro = [
  `We recognize that you may be concerned about our use and disclosure of your personal information. Your privacy is very important to us, and the following will inform you of the information that we, The Dieye Firm, may collect from you, and how it is used. By using our website, www.dieyelaw.com, you are accepting the practices described in this policy.`,
];

const sections = [
  {
    heading: "Information Collection",
    blocks: [
      { p: `We may collect non-personal information, such as a domain name and IP Address. The domain name and IP address reveals nothing personal about you other than the IP address from which you have accessed our site. We may also collect information about the type of Internet browser you are using, operating system, what brought you to our Website, as well as which of our Web pages you have accessed.` },
      { p: `Additionally, if you communicate with us regarding our Website or our services, we will collect any information that you provide to us in any such communication.` },
      { p: `We may contact you via email in the future to tell you about specials, new products or services, or changes to this privacy policy.` },
    ],
  },
  {
    heading: "Information Use",
    blocks: [
      { p: `We use the collected information primarily for our own internal purposes, such as providing, maintaining, evaluating, and improving our services and Website, fulfilling requests for information, and providing customer support.` },
    ],
  },
  {
    heading: "Security",
    blocks: [
      { p: `We follow generally accepted industry standards to protect the information submitted to us, both during transmission and once we receive it.` },
      { p: `If we collect sensitive information (such as credit card data), that information is encrypted and transmitted to us in a secure way. You can verify this by looking for a closed lock icon at the bottom of your web browser, or looking for &ldquo;https&rdquo; at the beginning of the address of the web page.` },
      { p: `While we use encryption to protect sensitive information transmitted online, we also protect your information offline. Only employees who need the information to perform a specific job (for example, billing or customer service) are granted access to personally identifiable information. The computers/servers in which we store personally identifiable information are kept in a secure environment.` },
    ],
  },
  {
    heading: "Cookies",
    blocks: [
      { p: `We use &ldquo;cookies&rdquo; on this site. A cookie is a piece of data stored on a site visitor&rsquo;s hard drive to help us improve your access to our site and identify repeat visitors to our site. For instance, when we use a cookie to identify you, you would not have to log in a password more than once, thereby saving time while on our site. Cookies can also enable us to track and target the interests of our users to enhance the experience on our site. Usage of a cookie is in no way linked to any personally identifiable information on our site.` },
    ],
  },
  {
    heading: "Sharing",
    blocks: [
      { p: `We will not sell or otherwise provide the information we collect to outside third parties for the purpose of direct or indirect mass email marketing.` },
      { p: `We will disclose personal information and/or an IP address, when required by law or in the good-faith belief that such action is necessary to:` },
      {
        ul: [
          `Cooperate with the investigations of purported unlawful activities and conform to the edicts of the law or comply with legal process served on our company`,
          `Protect and defend the rights or property of our Website and related properties`,
          `Identify persons who may be violating the law, the rights of third parties, or otherwise misusing our Website or its related properties`,
        ],
      },
      { p: `Please keep in mind that whenever you voluntarily disclose personal information online - for example through e-mail, discussion boards, or elsewhere - that information can be collected and used by others. In short, if you post personal information online that is accessible to the public, you may receive unsolicited messages from other parties in return.` },
      { p: `Ultimately, you are solely responsible for maintaining the secrecy of your personal information. Please be careful and responsible whenever you are online.` },
    ],
  },
  {
    heading: "Links",
    blocks: [
      { p: `This Website may contain links to other sites. Please be aware that we are not responsible for the content or privacy practices of such other sites. We encourage our users to be aware when they leave our site and to read the privacy statements of any other site that collects personally identifiable information.` },
    ],
  },
  {
    heading: "Surveys &amp; Contests",
    blocks: [
      { p: `From time-to-time our site may request information via surveys or contests. Participation in these surveys or contests is completely voluntary and you may choose whether or not to participate and therefore disclose this information. Information requested may include contact information (such as name and shipping address), and demographic information (such as zip code, age). Contact information will be used to notify the winners and award prizes. Survey information will be used for purposes of monitoring or improving the use and satisfaction of this site.` },
    ],
  },
  {
    heading: "Consent",
    blocks: [
      { p: `By using this Website, you consent to the collection and use of information as specified above. If we make changes to our Privacy Policy, we will post those changes on this page. Please review this page frequently to remain up-to-date with the information we collect, how we use it, and under what circumstances we disclose it. You must review the new Privacy Policy carefully to make sure you understand our practices and procedures.` },
      /* Deviation 2: the NAP is interpolated, not literal. The source bolds this
         whole paragraph across two adjacent <strong> tags; one is enough. */
      { contact: `If you feel that we are not abiding by this privacy policy, you should contact us immediately via telephone at` },
    ],
  },
];

/* WebPage, not Article and not another LegalService. This is not editorial
   content with an author, and every practice-area page already nests a
   LegalService carrying the same NAP, so a further copy adds nothing — the same
   call /practice-areas/ and the Choosing guide both make.

   Deliberately no datePublished or dateModified: the source page carries
   neither, and inventing one on a legal document is worse here than anywhere
   else on the site. */
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Privacy Policy",
  description,
  inLanguage: "en-US",
  publisher: { "@type": "Organization", name: firm.firmName },
  url: canonical,
};
---

<Layout title="Privacy Policy | The Dieye Firm" description={description} canonical={canonical}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  {/* In flow, not overlay: there is no hero here. The page opens directly under
      the header on white, the same as both interior templates. */}
  <Header />

  <InteriorShell>
    <InteriorHeader title="Privacy Policy" kicker={{ label: "Legal" }} />

    {/* .prose lives unscoped in global.css, which is also why the paragraphs can
        arrive through set:html and still be styled. `.pp__body` is scoped and
        still reaches this div — see the note in InteriorShell about where Astro
        assigns a scope hash. */}
    <div class="prose pp__body">
      {intro.map((html) => <p set:html={html} />)}

      {
        sections.map((section) => (
          <>
            <h2 set:html={section.heading} />
            {section.blocks.map((block) =>
              "ul" in block ? (
                <ul>
                  {block.ul.map((item) => (
                    <li set:html={item} />
                  ))}
                </ul>
              ) : "contact" in block ? (
                <p>
                  <strong>
                    <Fragment set:html={block.contact} />{" "}
                    <a href={firm.phone.href}>{firm.phone.display}</a> or via mail Attn: Privacy
                    Officer, {firm.address.oneLine}.
                  </strong>
                </p>
              ) : (
                <p set:html={block.p} />
              )
            )}
          </>
        ))
      }
    </div>

    {/* No `areas`: AboutSidebar renders the practice-area menu only when it is
        given one, and this page is not a cross-reference to that section — the
        live privacy policy carries no such list, and a visitor reading a privacy
        policy is not shopping for a practice area. Omitting it also means this
        page needs neither the `data-pa-boot` stamp nor initPracticeAreaNav(),
        so it ships no JavaScript of its own. */}
    <AboutSidebar slot="sidebar" label="The Dieye Firm" />
  </InteriorShell>
</Layout>

<style>
  /* Interior section copy runs 18px/30px (AGENTS.md), matching the
     practice-area template rather than the blog's 17px/29px. */
  .pp__body {
    margin-top: 40px;
    font-size: 18px;
    line-height: 30px;
  }
</style>
