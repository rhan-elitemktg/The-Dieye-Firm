---
// Privacy Policy — the firm's own published policy, on the interior
// main+sidebar template.
//
// WHERE THE COPY COMES FROM. There is no comp for this page, and none is
// possible: a privacy policy is a legal commitment on the firm's behalf, so
// the only defensible source is the firm's own published text. These 888 words
// are taken verbatim from dieyelaw.com/privacy-policy/, which is live and
// returns 200 today. Same rule as
// /about-us/choosing-a-family-law-attorney/ and the five ingested bodies:
// AGENTS.md's "leave the client's published prose alone" governs every
// sentence below.
//
// The live page has NO data-content container of the shape AGENTS.md's grep
// looks for, because that grep is anchored on `id="…" … data-content` and this
// page's block carries no id. It is `#PrivacyPolicyS1 > .cnt-stl[data-content]`,
// a single container holding the whole policy — measured, not assumed: the
// section is 888 words and the block is 888 words, so nothing sits outside it.
// (Enumerating on the id-anchored pattern alone would have reported "no
// containers" on a page that has one. Worth knowing before the next ingest.)
//
// No redirect is involved. The live URL is /privacy-policy/ and so is ours.
// It is NOT in dieyelaw.com/sitemap.xml, so it carries no equity by AGENTS.md's
// test — but the URL matches exactly regardless, so there is nothing to add to
// vercel.json either way.
//
// THREE DELIBERATE DEVIATIONS from verbatim, listed here the way ReviewWall and
// the Choosing guide list their own. Add to this list rather than editing a
// sentence silently:
//
//   1. Straight quotes and apostrophes are curled. The source is pure ASCII —
//      "cookies", "https", visitor's — which renders as typewriter punctuation
//      next to every other page on the site. This is typography, not prose: no
//      word, order or emphasis changes.
//   2. The phone number and street address in the closing paragraph render from
//      the firmDetails singleton rather than as literal text. The source says
//      "12280 Broadway Street, Suite 3105"; firmDetails says "12280 W Broadway
//      St Ste 3105", which is what the footer, the contact page and the
//      LegalService markup all emit. A privacy policy whose address disagrees
//      with the rest of the site is worse than one that differs from the old
//      page, and AGENTS.md already forbids hardcoding the phone number.
//      The phone also becomes a tel: link, which the source's plain text isn't.
//   3. The h2s are the client's own. Unlike the Choosing guide, this page came
//      with its eight headings, so none of them is ours.
//
// The trailing "This policy was last updated…" line that some policies carry is
// absent from the source, and is NOT invented here — the same call AuthorCard
// makes about dates it doesn't have. It arrives in the Sanity pass, with a real
// value the firm supplies.

import Layout from "../layouts/Layout.astro";
import Header from "../components/header/Header.astro";
import InteriorShell from "../components/interior/InteriorShell.astro";
import InteriorHeader from "../components/interior/InteriorHeader.astro";
import AboutSidebar from "../components/about/AboutSidebar.astro";
import { getFirmDetails } from "../sanity/firmDetails";
import { getPrivacyPolicyPage } from "../sanity/privacyPolicyPage";
import ProseBody from "../components/prose/ProseBody.astro";

const firm = await getFirmDetails();

const canonical = new URL("/privacy-policy/", Astro.site ?? Astro.url).href;

const description =
  "How The Dieye Firm collects, uses, shares and protects the information you provide through dieyelaw.com.";

const { header, intro, sections } = await getPrivacyPolicyPage();


/* WebPage, not Article and not another LegalService. This is not editorial
   content with an author, and every practice-area page already nests a
   LegalService carrying the same NAP, so a further copy adds nothing — the same
   call /practice-areas/ and the Choosing guide both make.

   Deliberately no datePublished or dateModified: the source page carries
   neither, and inventing one on a legal document is worse here than anywhere
   else on the site. */
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Privacy Policy",
  description,
  inLanguage: "en-US",
  publisher: { "@type": "Organization", name: firm.firmName },
  url: canonical,
};
---

<Layout title="Privacy Policy | The Dieye Firm" description={description} canonical={canonical}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  {/* In flow, not overlay: there is no hero here. The page opens directly under
      the header on white, the same as both interior templates. */}
  <Header />

  <InteriorShell>
    <InteriorHeader title={header.title} kicker={{ label: header.kicker }} />

    {/* .prose lives unscoped in global.css, which is also why the paragraphs can
        arrive through set:html and still be styled. `.pp__body` is scoped and
        still reaches this div — see the note in InteriorShell about where Astro
        assigns a scope hash. */}
    <div class="prose pp__body">
      <ProseBody value={intro} />

      {
        sections.map((section) => (
          <>
            {/* The heading is a plain string beside the rich text, not a block
                inside it: a Portable Text heading renders through ProseHeading,
                which stamps an id, and these eight never had one. */}
            <h2>{section.heading}</h2>
            <ProseBody value={section.body} />
            {section.contactNote && (
              <p>
                <strong>
                  {section.contactNote}{" "}
                  <a href={firm.phone.href}>{firm.phone.display}</a> or via mail Attn: Privacy
                  Officer, {firm.address.oneLine}.
                </strong>
              </p>
            )}
          </>
        ))
      }
    </div>

    {/* No `areas`: AboutSidebar renders the practice-area menu only when it is
        given one, and this page is not a cross-reference to that section — the
        live privacy policy carries no such list, and a visitor reading a privacy
        policy is not shopping for a practice area. Omitting it also means this
        page needs neither the `data-pa-boot` stamp nor initPracticeAreaNav(),
        so it ships no JavaScript of its own. */}
    <AboutSidebar slot="sidebar" label="The Dieye Firm" />
  </InteriorShell>
</Layout>

<style>
  /* Interior section copy runs 18px/30px (AGENTS.md), matching the
     practice-area template rather than the blog's 17px/29px. */
  .pp__body {
    margin-top: 40px;
    font-size: 18px;
    line-height: 30px;
  }
</style>
