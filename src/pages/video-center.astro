---
import { getVideoCenterPage } from "../sanity/videoCenterPage";
import Layout from "../layouts/Layout.astro";
import Header from "../components/header/Header.astro";
import BlogHeader from "../components/blog/BlogHeader.astro";
import VideoGrid from "../components/video-center/VideoGrid.astro";
import WhatDrivesUs from "../components/about/WhatDrivesUs.astro";
import { getSeo } from "../sanity/globalSeo";

const { header } = await getVideoCenterPage();

const canonical = new URL("/video-center/", Astro.site ?? Astro.url).href;

/* CollectionPage rather than a list of VideoObject. VideoObject wants an
   uploadDate and a real per-video description, neither of which exists for
   these nine, and the thumbnailUrl it would declare is one of our own
   photographs rather than a frame from the video. Same reasoning as the note
   in testimonials.astro: honest UI now, schema when the data supports it. */
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Video Center",
  description:
    "Short videos from attorney Papa Dieye on Texas divorce, child custody and choosing a family law attorney.",
  url: canonical,
};

const seo = await getSeo("videoCenterPage");
---

<Layout seo={seo}
  title="Video Center | The Dieye Firm"
  description="Watch attorney Papa Dieye explain Texas divorce, child custody and how to choose a family law attorney - short videos for Pearland and Houston families."
  canonical={canonical}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  {/* In flow, not overlay: the page opens on white type with no hero photo,
      exactly as the blog index does, so a transparent header would sit on
      white. */}
  <Header />

  <BlogHeader title={header.title} intro={header.intro} eyebrow={header.eyebrow} />

  <VideoGrid />

  <WhatDrivesUs />
</Layout>
