---
// Choosing a Texas Family Law Attorney — the client's own guide to hiring an
// attorney, on the interior main+sidebar template.
//
// WHERE THE COPY COMES FROM. There is no comp for this page. The six
// paragraphs below are the client's own published prose, taken verbatim from
// dieyelaw.com/about-us/choosing-a-family-law-attorney/ — 739 words, split on
// the live site across #MainContent (325) and #ContentS3RightContent (414),
// which is Scorpion's two-column wrapper and not an editorial division. Taking
// only the first container would have shipped less than half the page while
// looking like it worked, the same trap the practice-area scraper documents.
//
// AGENTS.md's "leave the client's published prose alone" governs it, so their
// en dashes and the one em-dash pair are theirs and are kept. The five
// headings are ours and follow the repo's spaced-hyphen rule.
//
// The FAQ block at the foot of the live page is NOT page content — it is
// sitewide boilerplate, byte-identical across the old About Us pages — so it
// is excluded.
//
// FOUR DELIBERATE DEVIATIONS from verbatim, listed here the way ReviewWall
// lists its own. Add to this list rather than editing the copy silently:
//
//   1. "Lawyer" -> "lawyers", twice, both in the consultation section ("a few
//      Lawyer you like", "Many Lawyer will offer"). A singular noun after "a
//      few" and "many" is a CMS defect, not a voice. Nothing else is reworded.
//   2. The five h2s are ours. The live page has no headings at all and no h1
//      either — its visible page title is a styled <p> — and 739 words of
//      unbroken prose is unscannable. Each heading names what the paragraph
//      beneath it already says; none adds a claim.
//   3. The self-referential link in the final paragraph is dropped. The words
//      "choosing an attorney" stay; a link to the page you are already on is a
//      dead end, not navigation.
//   4. The link to /family-law/divorce/ in the opening paragraph is KEPT.
//
// The h1 is the live page's own visible heading, which says "Texas". The
// <title> and the nav label in MainNav both say "Choosing a Family Law
// Attorney" without it. That disagreement is the client's, and it is the same
// title/navLabel split every practice-area page already carries.

import { getPracticeAreas } from "../../sanity/practiceAreas";
import { getHiringGuidePage } from "../../sanity/hiringGuidePage";
import ProseBody from "../../components/prose/ProseBody.astro";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/header/Header.astro";
import InteriorShell from "../../components/interior/InteriorShell.astro";
import InteriorHeader from "../../components/interior/InteriorHeader.astro";
import AboutSidebar from "../../components/about/AboutSidebar.astro";
import WhatDrivesUs from "../../components/about/WhatDrivesUs.astro";

/* The sidebar's practice-area menu. The live page carries the same
   cross-reference — a flat card of twelve areas with labels auto-generated
   from their slugs ("Qdros", "Mediation Vs Litigation") — and FamilyLawNav is
   that list done properly: the 11 top-level areas on the client's own
   navLabels, children behind a "+". No `current` is passed; see AboutSidebar. */
const areas = await getPracticeAreas();

const canonical = new URL(
  "/about-us/choosing-a-family-law-attorney/",
  Astro.site ?? Astro.url
).href;

const description =
  "How to choose a family law attorney in Texas - where to base your lawyer, how to research one, what to ask at the consultation and how to weigh cost.";

/* Headings ours, paragraphs the client's. Kept as a named array so the Sanity
   sweep is a query and a map rather than a re-typing — the same shape
   ReviewWall's `reviews` and Hero's `stats` already use.

   Paragraphs carry inline HTML for the one link and render through set:html.
   That is safe here precisely because .prose is unscoped in global.css; a
   scoped rule would never reach set:html output. */
const { header, sections } = await getHiringGuidePage();


/* Article, not FAQPage and not another LegalService. The FAQ block on the live
   page is sitewide boilerplate that is not reproduced here, so FAQPage would
   mark up content the page doesn't have; and every practice-area page already
   nests a LegalService as its Service `provider`, so a further copy of the
   same NAP adds nothing — the same call /practice-areas/ makes.

   Deliberately no datePublished or dateModified. The source page carries
   neither, and inventing one is the error AuthorCard refuses to make with its
   footer line. They arrive in the Sanity pass, with real values. */
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Choosing a Texas Family Law Attorney",
  description,
  inLanguage: "en-US",
  author: { "@type": "Organization", name: "The Dieye Firm" },
  publisher: { "@type": "Organization", name: "The Dieye Firm" },
  mainEntityOfPage: canonical,
  url: canonical,
};
---

<Layout
  title="Choosing a Family Law Attorney | The Dieye Firm"
  description={description}
  canonical={canonical}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  {/* Stamped before <body> is parsed, so the sidebar's collapsed branches are
      never painted open and then closed. FamilyLawNav's hide rule is keyed on
      it; without JS the attribute never lands and every branch stays open, so
      no link is unreachable. Same pair as the practice-area route. */}
  <script is:inline slot="head">
    document.documentElement.setAttribute("data-pa-boot", "");
  </script>

  {/* In flow, not overlay: there is no hero here. The page opens directly
      under the header on white, the same as both interior templates. */}
  <Header />

  <InteriorShell>
    <InteriorHeader
      title={header.title}
      kicker={{ label: header.kicker, href: header.kickerHref }}
    />

    {/* .prose lives unscoped in global.css, which is also why the paragraphs
        can arrive through set:html and still be styled. `.cfa__body` is scoped
        and still reaches this div — see the note in InteriorShell about where
        Astro assigns a scope hash. */}
    <div class="prose cfa__body">
      {
        sections.map((section) => (
          <>
            {/* Plain <h2>, not a Portable Text heading: through ProseHeading it
                would gain an id these never had. */}
            <h2>{section.heading}</h2>
            <ProseBody value={section.body} />
          </>
        ))
      }
    </div>

    <AboutSidebar slot="sidebar" areas={areas} label="About this guide" />
  </InteriorShell>

  <WhatDrivesUs />

  {/* Bound here, once for the document — the same split Layout uses for
      lead-form.ts, so the sidebar component stays pure markup. */}
  <script>
    import { initPracticeAreaNav } from "../../scripts/pa-nav";
    initPracticeAreaNav();
  </script>
</Layout>

<style>
  /* Interior section copy runs 18px/30px (AGENTS.md), matching the
     practice-area template rather than the blog's 17px/29px. */
  .cfa__body {
    margin-top: 40px;
    font-size: 18px;
    line-height: 30px;
  }
</style>
