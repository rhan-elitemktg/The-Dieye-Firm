---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/header/Header.astro";
import PapaHero from "../../components/about/PapaHero.astro";
import WhoWeAre from "../../components/about/WhoWeAre.astro";
import ByTheNumbers from "../../components/about/ByTheNumbers.astro";
/* Not `Promise` — that name shadows the built-in inside this module. */
import FirmPromise from "../../components/about/FirmPromise.astro";
import MeetPapa from "../../components/about/MeetPapa.astro";
import Awards from "../../components/home/Awards.astro";
import Testimonials from "../../components/home/Testimonials.astro";
import WhyFamilyLaw from "../../components/about/WhyFamilyLaw.astro";
import WhatDrivesUs from "../../components/about/WhatDrivesUs.astro";
import { getSeo } from "../../sanity/globalSeo";

/* This page is the About Us page and the attorney bio at once — there is no
   separate /about-us/papa-dieye/ any more, so the title has to answer both
   "about this firm" and "who is Papa Dieye". It leads on his name because that
   is the distinctive half: "About The Dieye Firm" would only repeat the suffix
   the whole site already carries. */

const canonical = new URL("/about-us/", Astro.site ?? Astro.url).href;

/* The canonical entity page for Papa Dieye, and the destination of the two
   /about-us/ redirects (papa-dieye, the-difference), so the self-referencing
   canonical is doing real work: it tells Google which of the three URLs is the
   one. It was the last built page without one. */

const seo = await getSeo("aboutPage");
---

<Layout seo={seo}
  title="About Papa Dieye, Pearland Family Law Attorney | The Dieye Firm"
  description="Meet Papa Dieye, founding attorney of The Dieye Firm, and the people-first approach behind more than seventeen years of guiding Pearland and Houston families."
  canonical={canonical}
>
  {/* Not `overlay`. The Old Town Pearland hero photo puts Papa's head 11% down
      the frame, which lands it under the nav's gold CTA if the header floats
      over the hero. In flow, the photo starts below the header instead. */}
  <Header />
  <PapaHero />
  <WhoWeAre />
  <ByTheNumbers />
  <FirmPromise />
  <MeetPapa />
  <Awards />
  <Testimonials />
  <WhyFamilyLaw />
  <WhatDrivesUs />
</Layout>
