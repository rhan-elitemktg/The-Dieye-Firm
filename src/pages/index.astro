---
import Layout from "../layouts/Layout.astro";
import Header from "../components/header/Header.astro";
import Hero from "../components/home/Hero.astro";
import Awards from "../components/home/Awards.astro";
import About from "../components/home/About.astro";
import PracticeAreas from "../components/home/PracticeAreas.astro";
import FeaturedAttorney from "../components/home/FeaturedAttorney.astro";
import Testimonials from "../components/home/Testimonials.astro";
import SellingPoints from "../components/home/SellingPoints.astro";
import Faq from "../components/home/Faq.astro";
import VideoReels from "../components/home/VideoReels.astro";
import Community from "../components/home/Community.astro";
import GuideRequest from "../components/home/GuideRequest.astro";
import Blog from "../components/home/Blog.astro";

/* Self-referencing canonical. The homepage is reachable as / and as the
   destination of nothing, but it is the site's most-linked URL and was one of
   the last two pages without one. */
const canonical = new URL("/", Astro.site ?? Astro.url).href;
---

<Layout title="The Dieye Firm | Pearland & Houston Family Law" canonical={canonical}>
  <Header overlay />
  <Hero />
  <Awards />
  <About />
  <PracticeAreas />
  <FeaturedAttorney />
  <Testimonials />
  <SellingPoints />
  <Faq />
  <VideoReels />
  <Community />
  <GuideRequest />
  <Blog />
</Layout>
