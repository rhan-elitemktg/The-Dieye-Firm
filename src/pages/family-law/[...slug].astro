---
import { getPracticeAreas } from "../../sanity/practiceAreas";
import ProseBody from "../../components/prose/ProseBody.astro";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/header/Header.astro";
import InteriorShell from "../../components/interior/InteriorShell.astro";
import InteriorHeader from "../../components/interior/InteriorHeader.astro";
import PracticeAreaFaqs from "../../components/practice-areas/PracticeAreaFaqs.astro";
import PracticeAreaSidebar from "../../components/practice-areas/PracticeAreaSidebar.astro";
import { areaHref, SECTION_ROOT_ID } from "../../components/practice-areas/practiceAreas";
import { getFirmDetails } from "../../sanity/firmDetails";

/* The collection id is already the route tail — "divorce",
   "divorce/military-divorce" — because the scraper writes the files in that
   shape. A rest param consumes both depths, so one route covers all 32 pages.

   The section root is the exception: it is a real practice-area page that
   lives AT /family-law/, and a rest param renders the parent path when its
   value is undefined. That is why its id ("family-law") does not match its
   route — the only page in the section where the two differ. The practice-area
   INDEX is a separate page at /practice-areas/, built from the comp. */
export async function getStaticPaths() {
  const areas = await getPracticeAreas();
  return areas.map((area) => ({
    params: { slug: area.id === SECTION_ROOT_ID ? undefined : area.id },
    props: { area },
  }));
}

const { area } = Astro.props;

const areas = await getPracticeAreas();
const parent = area.data.parent
  ? areas.find((candidate) => candidate.id === area.data.parent)
  : undefined;

/* The kicker names the BRANCH you are in — the parent on a child page, the
   page itself on a top-level one. So /family-law/child-custody/ and
   /family-law/child-custody/out-of-state-custody/ both say "Child Custody",
   and the label stops changing shape as you move up and down a branch.

   A top-level page gets no href, because the only honest destination would be
   itself and a link to the page you are already on is a dead end. That is also
   why it isn't "Practice Areas" pointing at the index any more: the index is
   still one click away from the sidebar card's own title, so the main column
   doesn't have to carry it.

   Lives here rather than in InteriorHeader because this is the only caller that
   knows what a parent is; the header takes plain values. */
const kicker = parent
  ? { label: parent.data.navLabel, href: areaHref(parent) }
  : { label: area.data.navLabel };

const firm = await getFirmDetails();
const canonical = new URL(areaHref(area), Astro.site ?? Astro.url).href;

/* The source pages carry LegalService structured data, so dropping it on the
   rebuild would be a regression on the section that earns the most search
   traffic. Built from the same values as the markup, the way Faq.astro and the
   blog post template both already do it. */
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: area.data.navLabel,
  serviceType: area.data.navLabel,
  description: area.data.description,
  url: canonical,
  provider: {
    "@type": "LegalService",
    name: firm.firmName,
    telephone: firm.phone.display,
    address: {
      "@type": "PostalAddress",
      streetAddress: firm.address.street,
      addressLocality: firm.address.locality,
      addressRegion: firm.address.region,
      postalCode: firm.address.postalCode,
      addressCountry: "US",
    },
  },
  areaServed: firm.serviceAreas.map((serviceArea) => ({
    "@type": "Place",
    name: serviceArea.label,
  })),
};
---

<Layout
  title={`${area.data.seoTitle ?? area.data.title} | The Dieye Firm`}
  description={area.data.description}
  canonical={canonical}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  {/* Stamped before <body> is parsed, so a collapsed branch in the sidebar is
      never painted open and then closed. FamilyLawNav's hide rule is keyed on
      it; without JS the attribute never lands and every branch stays open. */}
  <script is:inline slot="head">
    document.documentElement.setAttribute("data-pa-boot", "");
  </script>

  {/* In flow, not overlay: there is no hero here. The page opens directly
      under the header on white, the same as both blog templates. */}
  <Header />

  <InteriorShell>
    <InteriorHeader title={area.data.title} kicker={kicker} deck={area.data.subtitle} />

    {/* .prose lives unscoped in global.css because Astro's scoping never
        reaches markup rendered by a child component. `.pa__body` below is
        scoped and still reaches this div: slotted markup carries the hash of
        the component that wrote it, not of the one that renders it. */}
    <div class="prose pa__body">
      <ProseBody value={area.body} />
    </div>

    <PracticeAreaFaqs faqs={area.data.faqs} />

    <PracticeAreaSidebar slot="sidebar" areas={areas} current={area} />
  </InteriorShell>

  {/* Nothing closes the page below the grid yet — the related-posts band that
      the blog template ends on was removed, and its replacement is still to
      come. */}

  {/* Bound here, once for the document, the same split Layout uses for
      lead-form.ts — the sidebar component stays pure markup. */}
  <script>
    import { initPracticeAreaNav } from "../../scripts/pa-nav";
    initPracticeAreaNav();
  </script>
</Layout>

<style>
  /* The grid itself lives in InteriorShell. Interior section copy runs
     18px/30px (AGENTS.md), one step up from the blog's 17px/29px — the one
     thing the two interior templates genuinely disagree about, so it stays
     here. Still scoped, and it still reaches the div above; see the note in
     InteriorShell about where Astro assigns a scope hash. */
  .pa__body {
    margin-top: 40px;
    font-size: 18px;
    line-height: 30px;
  }
</style>
