---
import { getBlogPosts } from "../../sanity/blogPosts";
import { getImage } from "astro:assets";
import fallbackImg from "../../assets/images/blog/blog-img.jpg";
import { urlFor } from "../../sanity/image";
import ProseBody from "../../components/prose/ProseBody.astro";
import { toPlainText } from "../../lib/portableText";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/header/Header.astro";
import InteriorShell from "../../components/interior/InteriorShell.astro";
import PostHeader from "../../components/blog/PostHeader.astro";
import KeyTakeaways from "../../components/blog/KeyTakeaways.astro";
import PostSidebar from "../../components/blog/PostSidebar.astro";
import RelatedPosts from "../../components/blog/RelatedPosts.astro";
import {
  allCategories,
  byNewest,
  isoDate,
  postHref,
  readingTime,
  relatedPosts,
} from "../../components/blog/blog";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;

const all = (await getBlogPosts()).sort(byNewest);
/* The sidebar lists five titles, the closing band shows three cards. Both come
   from the same ranking so the band is always a subset of the list. */
const sidebarRelated = relatedPosts(post, all, 5);
const related = sidebarRelated.slice(0, 3);
const categories = allCategories(all);
/* Reading time is computed from the article's WORDS. It used to be computed
   from the raw markdown, which counted every "##" and "-" as a word and so ran
   two posts a minute long. */
const minutes = readingTime(toPlainText(post.body));

const canonical = new URL(postHref(post), Astro.site ?? Astro.url).href;
/* The post's OWN artwork, or nothing.
 *
 * Kept separate from the social card below, because the two want different
 * answers when a post has no image. BlogPosting.image is a claim about what this
 * article depicts, and the firm's generic graphic on a post about custody law is
 * not that — Google would rather have no image than a wrong one. */
const articleImage = post.data.image
  ? urlFor(post.data.image).width(1200).height(630).fit("crop").auto("format").url()
  : undefined;

/* The social card, at the 1200x630 every platform crops toward. A post without
 * artwork falls back to the same placeholder its card uses in the archive: it
 * used to emit no og:image at all, so sharing that post produced a blank card.
 * That was the one surface the placeholder never reached, because the archive
 * falls back inside the component and this is built in the page.
 *
 * A Sanity URL is already absolute; a local asset is a build path, so it needs
 * resolving against the site origin — social scrapers don't follow relative
 * URLs. */
const ogImage =
  articleImage ??
  new URL(
      (await getImage({ src: fallbackImg, width: 1200, height: 630, format: "jpeg" })).src,
      Astro.site ?? Astro.url,
    ).href;

/* Built from the same values as the markup so the two can't drift — the same
   pattern Faq.astro uses for its FAQPage schema. */
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: isoDate(post.data.date),
  author: { "@type": "Organization", name: post.data.author },
  publisher: { "@type": "Organization", name: "The Dieye Firm" },
  mainEntityOfPage: canonical,
  ...(articleImage ? { image: articleImage } : {}),
};
---

<Layout seo={post.seo}
  title={`${post.data.seoTitle ?? post.data.title} | The Dieye Firm`}
  description={post.data.description}
  canonical={canonical}
  ogType="article"
  ogImage={ogImage}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  {/* In flow, not overlay: there is no hero here — the article opens directly
      under the header, so a transparent header would sit on white. */}
  <Header />

  <InteriorShell>
    <PostHeader title={post.data.title} categories={post.data.categories} />

    <KeyTakeaways items={post.data.keyTakeaways ?? []} />

    {/* .prose lives unscoped in global.css because Astro's scoping never
        reaches markup rendered by a child component. `.post__body` below is
        scoped and still reaches this div: slotted markup carries the hash of
        the component that wrote it, not of the one that renders it. */}
    <div class="prose post__body">
      <ProseBody value={post.body} />
    </div>

    <PostSidebar
      slot="sidebar"
      date={post.data.date}
      minutes={minutes}
      categories={categories}
      activeCategories={post.data.categories}
      related={sidebarRelated}
    />
  </InteriorShell>

  <RelatedPosts posts={related} />
</Layout>

<style>
  /* The grid itself lives in InteriorShell. This is the one thing the two
     interior templates genuinely disagree about: a post runs 17px/29px, a
     practice area 18px/30px. Still scoped, and it still reaches the div above
     — see the note in InteriorShell about where Astro assigns a scope hash. */
  .post__body {
    margin-top: 40px;
    font-size: 17px;
    line-height: 29px;
  }
</style>
