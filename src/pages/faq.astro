---
import Layout from "../layouts/Layout.astro";
import Header from "../components/header/Header.astro";
import BlogHeader from "../components/blog/BlogHeader.astro";
import Faq from "../components/home/Faq.astro";
import { getFaqs } from "../sanity/faqs";
import WhatDrivesUs from "../components/about/WhatDrivesUs.astro";

/* The nine questions the client publishes at /faq/, in their own words, from
   the `faq` collection. Their prose is left alone - curly apostrophes,
   "$5,000.00", "20 percent" and all - because it is theirs and it carries the
   equity. The one question that departs from the live page carries its own
   `note` field saying why, and is logged in docs/live-site-corrections.md.

   The homepage renders six of these nine condensed by us; those are the same
   documents' `shortAnswer`. The two sets deliberately differ, so the pages are
   not duplicates of each other. */
const faqs = await getFaqs();

/* Authored, like /video-center/'s: the live page has a bare "FAQ" banner and
   no intro copy at all. Spaced hyphen rather than an em dash, per AGENTS.md,
   because this is copy we wrote. */
const title = "Frequently Asked Questions";
const intro =
  "The questions Texas families ask most about divorce, custody and support - answered plainly, before you ever pick up the phone.";

const canonical = new URL("/faq/", Astro.site ?? Astro.url).href;
---

<Layout
  title="Frequently Asked Questions | The Dieye Firm"
  description="Answers to common Texas family law questions on divorce, child custody, child support and spousal support, from Pearland attorney Papa Dieye."
  canonical={canonical}
>
  {/* In flow, not overlay: the page opens on white type with no hero photo,
      the same as /blog/ and /video-center/. */}
  <Header />

  <BlogHeader title={title} intro={intro} eyebrow="Common Questions" />

  {/* head={false}: the header above is already a kicker and a heading, and the
      component's own eyebrow + h2 under it would read as a stutter. The
      FAQPage JSON-LD it emits is generated from these nine. */}
  <Faq items={faqs} head={false} />

  <WhatDrivesUs />
</Layout>
