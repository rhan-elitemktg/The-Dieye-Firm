---
import { Font } from "astro:assets";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import VideoModal from "../components/VideoModal.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /* Absolute URL. Blog posts are the first genuinely shareable pages on the
     site, which is where these earned their keep. The full editable SEO layer
     (global defaults, sitemap, robots, editor-managed redirects) is a later
     pass — this is only what a shared page needs to be linked correctly. */
  canonical?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  /* /contact-us/ is the one page where the sitewide Contact section is the
     page rather than its closing prompt, so it renders a stripped-back
     variant. Forwarded rather than letting the page render its own Contact:
     one component, one form, one place the markup lives. See Contact.astro.

     "none" drops the section entirely, and /thank-you/ is the one page that
     asks for it: the visitor has just submitted this exact form, so closing
     with "Take the First Step - reach out for a free consultation" invites a
     duplicate enquiry and reads as though the first one didn't register. The
     comp omits it there too. Still a Layout prop rather than a page opting out
     by omission, so the default stays "every page closes with the prompt". */
  contactVariant?: "section" | "page" | "none";
}

const {
  title,
  description = "The Dieye Firm — compassionate, experienced family law representation.",
  canonical,
  ogType = "website",
  ogImage,
  contactVariant = "section",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="The Dieye Firm" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {/* Fonts: Source Serif 4 (headings) + Geist (body/UI), self-hosted and
        emitted by Astro. These are variable faces, so all weights come from
        three files (serif roman, serif italic, sans) and every one of them
        renders above the fold. Preloading all three is therefore the right
        trade — there are no unused weights to hold back. */}
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    {/* Script face — one decorative word, below the fold. No preload: it
        should never contend with the two families above. */}
    <Font cssVariable="--font-script" />

    {/* Per-page head additions — JSON-LD, mostly. */}
    <slot name="head" />
  </head>
  <body>
    <slot />
    {/* Site chrome — every page closes with the consultation prompt and the
        footer, so they live here rather than being remembered per page.
        /thank-you/ is the sole exception; see contactVariant above. */}
    {contactVariant !== "none" && <Contact variant={contactVariant} />}
    {/* For the rare section that has to sit below the consultation prompt
        rather than above it. /contact-us/ puts its office map here, because
        the comp runs hero → form → map and the default slot is above Contact,
        which would push the form under a 600px map. */}
    <slot name="after-contact" />
    <Footer />
    {/* Rendered at body level so `position: fixed` can never be broken by an
        ancestor transform/filter/contain, and so any page's video triggers
        have a modal to open without having to remember to include one. */}
    <VideoModal />

    {/* Enquiry-form behaviour, bound once for the whole document. Layout owns
        it because Layout is what guarantees a form is on the page at all
        (Contact, above) — and because a page may add more, as a blog post's
        sidebar does. The module binds each form separately. */}
    <script>
      import { initLeadForms } from "../scripts/lead-form";
      initLeadForms();
    </script>
  </body>
</html>
